      "blocks": {
        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "What do I get with this bundle?",
            "answer": "<p>A Yarbo Core, a Lawn Mower Pro Module, and a Snow Blower Module. Swap between them in minutes so one machine covers your lawn from spring through fall and your driveway all winter.</p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "How does setup work with no boundary wires?",
            "answer": "<p>The Core uses RTK GPS positioning, binocular vision, and multi-sensor fusion to map your property to centimeter accuracy, all through the Yarbo app. No trenching, no perimeter wire.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "Can it handle slopes and rough ground?",
            "answer": "<p>Yes. The Core's tracked chassis climbs up to a 70% (35°) grade, terrain that stops wheeled mowers and snow blowers outright.</p>",
            "icon": "none"
          }
        },
        "question_EcA6Mx": {
          "type": "question",
          "settings": {
            "question": "How much can the Lawn Mower Pro Module cover?",
            "answer": "<p>Up to 6.2 acres at a twice-weekly mowing cycle, with cutting height adjustable from 0.8” to 4.0” across 20 settings.</p>",
            "icon": "none"
          }
        },
        "question_BQYmLz": {
          "type": "question",
          "settings": {
            "question": "How does the Snow Blower Module know when to start?",
            "answer": "<p>It connects to live weather forecasting through the Yarbo app, starting automatically when snow falls and pre-clearing ahead of a forecasted storm.</p>",
            "icon": "none"
          }
        },
        "question_JjXiyk": {
          "type": "question",
          "settings": {
            "question": "What happens if it encounters an obstacle?",
            "answer": "<p>Vision, RTK positioning, and real time obstacle detection work together to identify pets, toys, or furniture and route around them before they're ever a concern.</p>",
            "icon": "none"
          }
        },
        "question_JxkamV": {
          "type": "question",
          "settings": {
            "question": "What kind of support do I get after purchase?",
            "answer": "<p>Covered by Yarbo's standard 2-year manufacturer warranty on defective parts, excluding consumables, from the date your machine is activated. Supported by Yard Automation Pros before and after the sale.</p>",
            "icon": "none"
          }
        }
      },
