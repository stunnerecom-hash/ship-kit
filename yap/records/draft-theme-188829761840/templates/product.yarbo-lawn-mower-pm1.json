    "dynamic_custom_liquid_pm1Kit": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .kcg { max-width: 1200px; margin: 0 auto; padding: 48px 24px; }\n  .kcg__heading { font-size: clamp(26px, 3.5vw, 36px); font-weight: 700; color: #232739; text-align: center; margin: 0 0 8px; }\n  .kcg__subhead { font-size: 16px; color: #393939; text-align: center; margin: 0 0 36px; }\n  .kcg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  @media screen and (max-width: 749px) { .kcg-grid { grid-template-columns: 1fr; } }\n  .kcg-card { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; box-shadow: 0 1px 3px rgba(35,39,57,.08); transition: box-shadow .2s ease; overflow: hidden; text-align: center; }\n  .kcg-card:hover { box-shadow: 0 4px 14px rgba(35,39,57,.12); }\n  .kcg-card__well { position: relative; aspect-ratio: 1 / 1; background: #fff; display: flex; align-items: center; justify-content: center; padding: 28px; }\n  .kcg-card__photo { width: 100%; height: 100%; object-fit: contain; }\n  .kcg-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }\n  .kcg-card__badge { width: 96px; height: 96px; border-radius: 50%; background: #f2f4f1; border: 1.5px solid #c9a84c; display: flex; align-items: center; justify-content: center; }\n  .kcg-card__badge svg { width: 48px; height: 48px; }\n  .kcg-card__tag { position: absolute; top: 10px; right: 10px; font-size: 10px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #c9a84c; background: #fff; border: 1px solid #c9a84c; border-radius: 20px; padding: 4px 9px; }\n  .kcg-card__label { font-size: 17px; font-weight: 700; color: #232739; margin: 4px 0 4px; padding: 0 16px; }\n  .kcg-card__text { font-size: 13.5px; color: #393939; line-height: 1.4; margin: 0 0 20px; padding: 0 18px; }\n</style>\n<div class=\"kcg\">\n  <h2 class=\"kcg__heading\">What's in the Kit</h2>\n  <p class=\"kcg__subhead\">One Core, two modules, every season covered.</p>\n  <div class=\"kcg-grid\">\n    {% render 'kit-contents-card', file: 'Yarbo_Core_1_0ed79aa3-2c3a-4f5d-9332-3b4036e2c3cd.png', icon: 'core', label: 'Yarbo Core', text: 'The all-terrain tracked base that powers both modules.' %}\n    {% render 'kit-contents-card', file: 'Yarbo_Lawn_Mower_Pro_6_4d857884-7fd4-4303-9c29-38d73cfeb562.webp', icon: 'mower', label: 'Lawn Mower Pro Module', text: 'Dual 300W motors, up to 6.2 acres of coverage per cycle.' %}\n    {% render 'kit-contents-card', file: 'Snow_Blower_Module.webp', icon: 'snow', label: 'Snow Blower Module', text: '24-inch clearing width, up to 40 feet of throw distance.' %}\n  </div>\n</div>"
      }
