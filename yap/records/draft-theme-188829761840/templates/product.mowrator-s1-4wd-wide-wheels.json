        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "How is this different from the Grip Tread Tire Edition?",
            "answer": "<p>The Grip Tread Tire Edition uses deformable tires and is rated for 100% grade (45°), the highest in the S1 lineup. Wide Wheels uses a wider standard-type PU tire rated for 85% (40°), a step up from base but not as extreme.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "Does it damage the lawn more than standard wheels?",
            "answer": "<p>Less, if anything. The wider footprint distributes the mower's weight over more surface area, reducing compaction and tearing compared to a narrower tire carrying the same load.</p>",
            "icon": "none"
          }
        },
        "question_EcA6Mx": {
          "type": "question",
          "settings": {
            "question": "Is this remote-controlled or autonomous?",
