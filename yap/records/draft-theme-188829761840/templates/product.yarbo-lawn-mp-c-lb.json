        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "Do I need to buy two separate machines for mowing and leaf blowing?",
            "answer": "<p>No. One Yarbo Core powers both modules. Swap between mowing and leaf blowing in under 2 minutes with no tools required.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "How does Yarbo navigate without boundary wires?",
            "answer": "<p>RTK-GPS and stereo vision map your property precisely. No trenching, no buried wires, no professional installation. You define zones in the app and Yarbo holds them.</p>",
            "icon": "none"
          }
