    "dynamic_custom_liquid_lmpclbKit": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .kcg { max-width: 1200px; margin: 0 auto; padding: 48px 24px; }\n  .kcg__heading { font-size: clamp(26px, 3.5vw, 36px); font-weight: 700; color: #232739; text-align: center; margin: 0 0 8px; }\n  .kcg__subhead { font-size: 16px; color: #393939; text-align: center; margin: 0 0 36px; }\n  .kcg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }\n  .kcg-card { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; box-shadow: 0 1px 3px rgba(35,39,57,.08); transition: box-shadow .2s ease; overflow: hidden; text-align: center; }\n  .kcg-card:hover { box-shadow: 0 4px 14px rgba(35,39,57,.12); }\n  .kcg-card__well { position: relative; aspect-ratio: 1 / 1; background: #fff; display: flex; align-items: center; justify-content: center; padding: 28px; }\n  .kcg-card__photo { width: 100%; height: 100%; object-fit: contain; }\n  .kcg-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }\n  .kcg-card__badge { width: 96px; height: 96px; border-radius: 50%; background: #f2f4f1; border: 1.5px solid #c9a84c; display: flex; align-items: center; justify-content: center; }\n  .kcg-card__badge svg { width: 48px; height: 48px; }\n  .kcg-card__tag { position: absolute; top: 10px; right: 10px; font-size: 10px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #c9a84c; background: #fff; border: 1px solid #c9a84c; border-radius: 20px; padding: 4px 9px; }\n  .kcg-card__label { font-size: 17px; font-weight: 700; color: #232739; margin: 4px 0 4px; padding: 0 16px; }\n  .kcg-card__text { font-size: 13.5px; color: #393939; line-height: 1.4; margin: 0 0 20px; padding: 0 18px; }\n</style>\n<div class=\"kcg\">\n  <h2 class=\"kcg__heading\">What's in the Kit</h2>\n  <p class=\"kcg__subhead\">Everything you need for two seasons of autonomous yard care.</p>\n  <div class=\"kcg-grid\">\n    {% render 'kit-contents-card', file: 'Edit_image_text_2K_202609031507.jpg', icon: 'core', label: 'Yarbo Core', text: 'The all-terrain tracked base that powers both modules.' %}\n    {% render 'kit-contents-card', file: 'Yarbo_Lawn_Mower_Pro_6_4d857884-7fd4-4303-9c29-38d73cfeb562.webp', icon: 'mower', label: 'Lawn Mower Pro Module', text: 'Dual 300W motors, up to 6.2 acres of coverage.' %}\n    {% render 'kit-contents-card', file: 'Yarbo_Blower_on_driveway_2K_202609050156.jpg', icon: 'leaf', label: 'Leaf Blower Module', text: 'High velocity airflow clears leaves and debris automatically.' %}\n    {% render 'kit-contents-card', file: 'Frame_2036457866_c2ec0e67-77a9-489b-a47d-ec91a5a9bb86.png', icon: 'module', label: 'Yarbo Battery', text: 'Powers the Core across both modules.' %}\n    {% render 'kit-contents-card', icon: 'module', label: 'Data Center &amp; Docking Station', text: 'Auto-recharge base station for the Core.' %}\n  </div>\n</div>"
      }
    },
