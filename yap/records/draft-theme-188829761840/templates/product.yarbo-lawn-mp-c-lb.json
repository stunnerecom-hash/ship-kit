          "settings": {
            "question": "What warranty comes with this bundle?",
            "answer": "<p>Covered by Yarbo's standard 2-year manufacturer warranty on defective parts, excluding consumables, from the date your machine is activated. We reply to emails within 1 business day at support@yardautomationpros.com.</p>",
            "icon": "none"
          }
