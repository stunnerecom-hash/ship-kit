        "custom_liquid": "<style>\n  .lb-stack { max-width: 760px; margin: 0 auto; padding: 64px 24px; text-align: center; }\n  @media screen and (max-width: 749px) { .lb-stack { padding: 40px 20px; } }\n  .lb-stack__frame { border-radius: 14px; overflow: hidden; border: 1px solid #e5e5e5; box-shadow: 0 8px 28px rgba(35,39,57,.10); background: #fff; margin: 0 0 28px; }\n  .lb-stack__frame img { display: block; width: 100%; height: auto; max-width: 420px; margin: 0 auto; }\n  .lb-stack__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #c9a84c; margin: 0 0 14px; padding-bottom: 8px; border-bottom: 2px solid #c9a84c; }\n  .lb-stack__heading { font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #233923; margin: 0 0 16px; line-height: 1.2; }\n  .lb-stack__text { font-size: 16px; line-height: 1.6; color: #233923; margin: 0 auto; max-width: 560px; }\n</style>\n<div class=\"lb-stack\">\n  <div class=\"lb-stack__frame\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Yarbo_B1_1.png?v=1787782903\" alt=\"Yarbo Core and Leaf Blower Module shown separately, ready to attach\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n  </div>\n <h2 class=\"lb-stack__heading\">Attaches to the Core You Already Own</h2>\n  <p class=\"lb-stack__text\">The Leaf Blower Module is the fall half of the same modular system as the Lawn Mower Pro and Snow Blower. It mounts to the Yarbo Core's tracked chassis and comes back off in minutes when the season changes, one Core, swapped through all four seasons.</p>\n</div>"
      }
    },
    "dynamic_custom_liquid_lbMech": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .lb-callout { max-width: 1100px; margin: 0 auto; padding: 64px 24px; }\n  @media screen and (max-width: 749px) { .lb-callout { padding: 40px 20px; } }\n  .lb-callout__panel { display: flex; gap: 40px; align-items: center; background: #f2f4f1; border: 1px solid #d7ddd4; border-left: 4px solid #c9a84c; border-radius: 12px; padding: 36px; }\n  @media screen and (max-width: 819px) { .lb-callout__panel { flex-direction: column; text-align: center; } }\n  .lb-callout__img-wrap { flex: 0 0 220px; }\n  .lb-callout__img-wrap img { width: 100%; max-width: 220px; height: auto; border-radius: 10px; display: block; margin: 0 auto; background: #fff; }\n  .lb-callout__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #c9a84c; margin: 0 0 10px; }\n  h2.lb-callout__quote { font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; color: #233923; margin: 0 0 12px; line-height: 1.3; }\n  .lb-callout__text { font-size: 15.5px; line-height: 1.6; color: #233923; margin: 0; }\n</style>\n<div class=\"lb-callout\">\n  <div class=\"lb-callout__panel\">\n    <div class=\"lb-callout__img-wrap\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Yarbo_B1_4.png?v=1787782902\" alt=\"Close-up of the Yarbo Leaf Blower Module mounted to the Core, showing the fan housing and nozzle\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n    </div>\n    <div>\n      <span class=\"lb-callout__kicker\">21 N of Real Blowing Force</span>\n      <h2 class=\"lb-callout__quote\">Enough force to move debris, not just scatter it.</h2>\n      <p class=\"lb-callout__text\">The directional nozzle concentrates the airflow instead of spreading it thin, so wet leaves and packed debris actually move instead of just shifting in place.</p>\n    </div>\n  </div>\n</div>"
      }
    },
    "dynamic_custom_liquid_lbStats": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .lb-stats { max-width: 1100px; margin: 0 auto; padding: 64px 24px; text-align: center; }\n  @media screen and (max-width: 749px) { .lb-stats { padding: 40px 20px; } }\n  .lb-stats__heading { font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #233923; margin: 0 0 40px; }\n  .lb-stats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  @media screen and (max-width: 749px) { .lb-stats__grid { grid-template-columns: 1fr; } }\n  .lb-stats__card { background: #f2f4f1; border-radius: 12px; overflow: hidden; border: 1px solid #d7ddd4; }\n  .lb-stats__card img { display: block; width: 100%; height: 160px; object-fit: cover; }\n  .lb-stats__num { font-size: 28px; font-weight: 700; color: #233923; margin: 18px 0 4px; }\n  .lb-stats__label { font-size: 13.5px; color: #233923; opacity: .85; margin: 0 0 20px; padding: 0 16px; }\n</style>\n<div class=\"lb-stats\">\n  <h2 class=\"lb-stats__heading\">By the Numbers</h2>\n  <div class=\"lb-stats__grid\">\n    <div class=\"lb-stats__card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Frame_2036458135.webp?v=1788490664\" alt=\"Graphic showing the Yarbo Leaf Blower Module's 21 N blowing force along a debris trail\" loading=\"lazy\">\n      <p class=\"lb-stats__num\">21 N</p>\n      <p class=\"lb-stats__label\">Blowing force, enough to move real debris</p>\n    </div>\n    <div class=\"lb-stats__card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Frame_2036458136.webp?v=1788474368\" alt=\"Graphic showing the Yarbo Leaf Blower Module climbing a 35 degree, 70 percent slope\" loading=\"lazy\">\n      <p class=\"lb-stats__num\">35° (70%)</p>\n      <p class=\"lb-stats__label\">Max slope the Core's tracked chassis climbs</p>\n    </div>\n    <div class=\"lb-stats__card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Frame_2036458137.webp?v=1788474367\" alt=\"Graphic showing the Yarbo Leaf Blower Module's 70 minute continuous runtime per charge\" loading=\"lazy\">\n      <p class=\"lb-stats__num\">70 min</p>\n      <p class=\"lb-stats__label\">Continuous runtime per charge</p>\n    </div>\n  </div>\n</div>"
      }
    },
