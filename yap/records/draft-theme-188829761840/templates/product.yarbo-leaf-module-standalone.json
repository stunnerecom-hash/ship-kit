    "dynamic_faq_lbm": {
      "type": "dynamic-faq",
      "blocks": {
        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "Do I need to already own a Yarbo Core?",
            "answer": "<p>Yes. This is a module only, it attaches to a Core you already own. If you don't have one yet, the Leaf Blower bundle includes both the Core and this module together.</p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "How do I install it?",
            "answer": "<p>It attaches to your existing Core in minutes, no tools or wiring required. Set your clearing schedule through the Yarbo app afterward.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "Can I switch back to the mower or snow blower module?",
            "answer": "<p>Yes. Modules swap on and off the same Core in minutes, so you can switch between mowing, leaf clearing, and snow clearing as the seasons change.</p>",
            "icon": "none"
          }
        },
        "question_FrcXQs": {
          "type": "question",
          "settings": {
            "question": "How much force does it actually blow with?",
            "answer": "<p>Up to 21 N of blowing force, enough to move real debris, wet leaves and packed clippings included, not just scatter what's already loose.</p>",
            "icon": "none"
          }
        },
        "question_KLmzTf": {
          "type": "question",
          "settings": {
            "question": "Can it handle slopes or uneven ground?",
            "answer": "<p>Yes. The Core's tracked chassis climbs up to a 35° (70%) grade, terrain that stops most wheeled yard equipment outright.</p>",
            "icon": "none"
          }
        },
