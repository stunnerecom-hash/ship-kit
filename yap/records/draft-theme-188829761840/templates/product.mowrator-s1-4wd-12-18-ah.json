        "custom_liquid_7dtaiM": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div class=\"mpf-box\">\n\n  <div class=\"mpf-price\" id=\"mpf-price-{{ product.id }}\">\n    <span class=\"mpf-price-main\" id=\"mpf-price-val-{{ product.id }}\">\n      {{ current_variant.price | money }}\n    </span>\n\n    <div class=\"mpf-installment\" id=\"mpf-install-{{ product.id }}\">\n      From {{ current_variant.price | divided_by: 12 | money }}/mo with\n      <strong>shop</strong> ⓘ\n    </div>\n  </div>\n\n  <form\n    method=\"post\"\n    action=\"/cart/add\"\n    id=\"mpf-form-{{ product.id }}\"\n    enctype=\"multipart/form-data\"\n  >\n\n    <input type=\"hidden\" name=\"form_type\" value=\"product\">\n    <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n\n    <input\n      type=\"hidden\"\n      name=\"id\"\n      id=\"mpf-vid-{{ product.id }}\"\n      value=\"{{ current_variant.id }}\"\n    >\n\n    {% for option in product.options_with_values %}\n      <div class=\"mpf-option-group\">\n\n        <label class=\"mpf-option-label\">MODEL</label>\n\n        <div class=\"mpf-toggles\">\n\n          {% for value in option.values %}\n            <button\n              type=\"button\"\n              class=\"mpf-toggle {% if value == option.selected_value %}mpf-active{% elsif option.selected_value == blank and forloop.first %}mpf-active{% endif %}\"\n              data-index=\"{{ forloop.parentloop.index0 }}\"\n              data-value=\"{{ value | escape }}\"\n              onclick=\"mpfSelect(this, '{{ product.id }}')\"\n            >\n              {{ value }}\n            </button>\n          {% endfor %}\n\n        </div>\n      </div>\n    {% endfor %}\n\n    <div class=\"mpf-action-row\">\n\n      <div class=\"mpf-qty\">\n\n        <button\n          type=\"button\"\n          aria-label=\"Decrease quantity\"\n          onclick=\"mpfQty(-1,'{{ product.id }}')\"\n        >\n          −\n        </button>\n\n        <input\n          type=\"number\"\n          id=\"mpf-qty-{{ product.id }}\"\n          name=\"quantity\"\n          value=\"1\"\n          min=\"1\"\n          readonly\n          aria-label=\"Quantity\"\n        >\n\n        <button\n          type=\"button\"\n          aria-label=\"Increase quantity\"\n          onclick=\"mpfQty(1,'{{ product.id }}')\"\n        >\n          +\n        </button>\n\n      </div>\n\n      <button\n        type=\"submit\"\n        id=\"mpf-atc-{{ product.id }}\"\n        class=\"mpf-atc\"\n        {% unless current_variant.available %}disabled{% endunless %}\n      >\n        {% if current_variant.available %}\n          Add to cart\n        {% else %}\n          Sold out\n        {% endif %}\n      </button>\n\n    </div>\n\n  </form>\n\n</div>\n\n<script>\n  window['mpfVariants_{{ product.id }}'] = {{ product.variants | json }};\n\n  window['mpfSelected_{{ product.id }}'] = [\n    {% for option in product.options_with_values %}\n      \"{% if option.selected_value != blank %}{{ option.selected_value | escape }}{% else %}{{ option.values.first | escape }}{% endif %}\"\n      {% unless forloop.last %},{% endunless %}\n    {% endfor %}\n  ];\n\n  function mpfMoney(cents) {\n    return '$' + (cents / 100)\n      .toFixed(2)\n      .replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  }\n\n  function mpfSelect(btn, pid) {\n\n    var idx = parseInt(\n      btn.getAttribute('data-index'),\n      10\n    );\n\n    var val = btn.getAttribute('data-value');\n\n    btn.parentElement\n      .querySelectorAll('.mpf-toggle')\n      .forEach(function(b) {\n        b.classList.remove('mpf-active');\n      });\n\n    btn.classList.add('mpf-active');\n\n    window['mpfSelected_' + pid][idx] = val;\n\n    var variants = window['mpfVariants_' + pid];\n\n    var selected = window['mpfSelected_' + pid];\n\n    var match = variants.find(function(v) {\n\n      return v.options.every(function(optionValue, index) {\n\n        return optionValue === selected[index];\n\n      });\n\n    });\n\n    if (!match) {\n      return;\n    }\n\n    document.getElementById(\n      'mpf-vid-' + pid\n    ).value = match.id;\n\n    document.getElementById(\n      'mpf-price-val-' + pid\n    ).textContent = mpfMoney(match.price);\n\n    document.getElementById(\n      'mpf-install-' + pid\n    ).innerHTML =\n      'From ' +\n      mpfMoney(Math.ceil(match.price / 12)) +\n      '/mo with <strong>shop</strong> ⓘ';\n\n    var atc = document.getElementById(\n      'mpf-atc-' + pid\n    );\n\n    atc.disabled = !match.available;\n\n    atc.textContent = match.available\n      ? 'Add to cart'\n      : 'Sold out';\n\n    var variantEvent = new CustomEvent(\n      'variant:change',\n      {\n        bubbles: true,\n        detail: {\n          variant: match\n        }\n      }\n    );\n\n    document.dispatchEvent(variantEvent);\n\n    try {\n\n      var url = new URL(\n        window.location.href\n      );\n\n      url.searchParams.set(\n        'variant',\n        match.id\n      );\n\n      window.history.replaceState(\n        {},\n        '',\n        url.toString()\n      );\n\n    } catch (e) {}\n\n    if (match.featured_media) {\n\n      var mediaId = match.featured_media.id;\n\n      var mediaSelectors = [\n        '[data-media-id=\"' + mediaId + '\"]',\n        '[data-media-id=\"ProductJSON-' + mediaId + '\"]',\n        '[data-media-id*=\"' + mediaId + '\"]'\n      ];\n\n      for (var i = 0; i < mediaSelectors.length; i++) {\n\n        var media = document.querySelector(\n          mediaSelectors[i]\n        );\n\n        if (media) {\n\n          media.scrollIntoView({\n            behavior: 'smooth',\n            block: 'nearest'\n          });\n\n          break;\n        }\n      }\n    }\n\n  }\n\n  function mpfQty(delta, pid) {\n\n    var input = document.getElementById(\n      'mpf-qty-' + pid\n    );\n\n    var current = parseInt(\n      input.value,\n      10\n    ) || 1;\n\n    input.value = Math.max(\n      1,\n      current + delta\n    );\n\n  }\n</script>\n\n<style>\n\n  .mpf-box {\n    background: var(--color-background, #f8f8f6);\n    border: 1.5px solid #e0e0e0;\n    border-radius: 12px;\n    padding: 22px 20px 16px;\n    max-width: 480px;\n    font-family: inherit;\n  }\n\n  .mpf-price {\n    margin-bottom: 20px;\n  }\n\n  .mpf-price-main {\n    display: block;\n    font-size: 32px;\n    font-weight: 800;\n    letter-spacing: -1px;\n    color: #111;\n    margin-bottom: 5px;\n    line-height: 1.1;\n  }\n\n  .mpf-installment {\n    font-size: 13px;\n    color: #666;\n  }\n\n  .mpf-installment strong {\n    color: #5433ff;\n  }\n\n  .mpf-option-group {\n    margin-bottom: 18px;\n  }\n\n  .mpf-option-label {\n    display: block;\n    font-size: 12px;\n    font-weight: 500;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    margin-bottom: 10px;\n  }\n\n  .mpf-toggles {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .mpf-toggle {\n    width: 100%;\n    padding: 13px 16px;\n    border: 1.5px solid #d8d8d8;\n    border-radius: 8px;\n    background: #fff;\n    font-size: 14px;\n    font-weight: 400;\n    cursor: pointer;\n    text-align: left;\n    transition:\n      border-color 0.18s ease,\n      background 0.18s ease,\n      box-shadow 0.18s ease;\n    color: #333;\n    font-family: inherit;\n  }\n\n  .mpf-toggle:hover {\n    border-color: #aaa;\n    background: #fafafa;\n  }\n\n  .mpf-toggle.mpf-active {\n    border-color: #1a1a1a;\n    border-width: 2px;\n    background: #fff;\n    color: #1a1a1a;\n    font-weight: 500;\n  }\n\n  .mpf-action-row {\n    display: flex;\n    gap: 10px;\n    align-items: center;\n    margin-bottom: 14px;\n    margin-top: 4px;\n  }\n\n  .mpf-qty {\n    display: flex;\n    align-items: center;\n    border: 1.5px solid #d8d8d8;\n    border-radius: 8px;\n    overflow: hidden;\n    flex-shrink: 0;\n    background: #fff;\n  }\n\n  .mpf-qty button {\n    width: 40px;\n    height: 46px;\n    border: none;\n    background: transparent;\n    font-size: 20px;\n    cursor: pointer;\n    color: #333;\n  }\n\n  .mpf-qty button:hover {\n    background: #f0f0f0;\n  }\n\n  .mpf-qty input {\n    width: 50px;\n    height: 46px;\n    text-align: center;\n    border: none;\n    border-left: 1.5px solid #d8d8d8;\n    border-right: 1.5px solid #d8d8d8;\n    font-size: 15px;\n    background: #fff;\n    -moz-appearance: textfield;\n  }\n\n  .mpf-qty input::-webkit-outer-spin-button,\n  .mpf-qty input::-webkit-inner-spin-button {\n    -webkit-appearance: none;\n  }\n\n  .mpf-atc {\n    flex: 1;\n    height: 46px;\n    background: #1a3c1a;\n    color: #fff;\n    border: none;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: background 0.2s;\n    font-family: inherit;\n    letter-spacing: 0.3px;\n  }\n\n  .mpf-atc:hover {\n    background: #244d24;\n  }\n\n  .mpf-atc:disabled {\n    background: #bbb;\n    cursor: not-allowed;\n  }\n\n  @media screen and (max-width: 480px) {\n\n    .mpf-box {\n      padding: 18px 16px 14px;\n    }\n\n    .mpf-price-main {\n      font-size: 28px;\n    }\n\n    .mpf-action-row {\n      gap: 8px;\n    }\n\n    .mpf-qty button {\n      width: 36px;\n    }\n\n    .mpf-qty input {\n      width: 42px;\n    }\n\n  }\n\n</style>"
          }
