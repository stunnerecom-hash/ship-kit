    "dynamic_custom_liquid_yQqJPR": {
      "type": "dynamic-custom-liquid",
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "settings": {
        "custom_liquid": "<style>\n  .witb-cl {\n    background: transparent;\n    color: #1a1a1a;\n    padding: 32px 24px 56px;\n  }\n  .witb-cl__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    text-align: center;\n  }\n  .witb-cl__heading {\n    font-size: clamp(28px, 4vw, 44px);\n    font-weight: 700;\n    margin: 0 0 24px;\n    color: #1a1a1a;\n  }\n  .witb-cl__tabs {\n    display: flex;\n    justify-content: center;\n    gap: 32px;\n    margin-bottom: 40px;\n    border-bottom: 1px solid #d8d8d8;\n  }\n  .witb-cl__tab {\n    background: none;\n    border: none;\n    color: #8a8a8a;\n    font-size: 18px;\n    padding: 0 4px 14px;\n    cursor: pointer;\n    position: relative;\n  }\n  .witb-cl__tab.is-active {\n    color: #1a1a1a;\n  }\n  .witb-cl__tab.is-active::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: -1px;\n    height: 2px;\n    background: #1a1a1a;\n  }\n  .witb-cl__panel {\n    display: none;\n  }\n  .witb-cl__panel.is-active {\n    display: block;\n  }\n  .witb-cl__photo {\n    width: 100%;\n    height: auto;\n    border-radius: 4px;\n    display: block;\n  }\n</style>\n\n<section class=\"witb-cl\" id=\"witb-cl-{{ section.id }}\">\n  <div class=\"witb-cl__inner\">\n    <h2 class=\"witb-cl__heading\">What's in The Box</h2>\n\n    <div class=\"witb-cl__tabs\">\n      <button class=\"witb-cl__tab is-active\" data-witb-tab=\"kit-12\">4WD 12Ah</button>\n      <button class=\"witb-cl__tab\" data-witb-tab=\"kit-18\">4WD 18Ah</button>\n    </div>\n\n    <div class=\"witb-cl__panel is-active\" data-witb-panel=\"kit-12\">\n      <img\n        class=\"witb-cl__photo\"\n        src=\"https://mowrator.com/cdn/shop/files/20260528-212552.webp?v=1779974783&width=2800\"\n        alt=\"What's in the box - Mowrator S1 4WD 12Ah kit\"\n      >\n    </div>\n\n    <div class=\"witb-cl__panel\" data-witb-panel=\"kit-18\">\n      <img\n        class=\"witb-cl__photo\"\n        src=\"https://mowrator.com/cdn/shop/files/4WD-18.webp?v=1779877616&width=2800\"\n        alt=\"What's in the box - Mowrator S1 4WD 18Ah kit\"\n      >\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    var root = document.getElementById('witb-cl-{{ section.id }}');\n    if (!root) return;\n\n    var tabs = root.querySelectorAll('[data-witb-tab]');\n    var panels = root.querySelectorAll('[data-witb-panel]');\n\n    tabs.forEach(function (tab) {\n      tab.addEventListener('click', function () {\n        var target = tab.getAttribute('data-witb-tab');\n\n        tabs.forEach(function (t) {\n          t.classList.toggle('is-active', t === tab);\n        });\n\n        panels.forEach(function (panel) {\n          panel.classList.toggle('is-active', panel.getAttribute('data-witb-panel') === target);\n        });\n      });\n    });\n  })();\n</script>"
      }
    },
