><td>2,000 W</td></tr>\n          <tr><th scope=\"row\">Applicable slope</th><td>70% (35°)</td></tr>\n          <tr><th scope=\"row\">Operating time per charge</th><td>70 min</td></tr>\n          <tr><th scope=\"row\">Charging time (20-80%)</th><td>90 min</td></tr>\n          <tr><th scope=\"row\">IP rating</th><td>IPX5</td></tr>\n          <tr><th scope=\"row\">Connectivity</th><td>4G, Wi-Fi, Bluetooth, Wi-Fi HaLow</td></tr>\n          <tr><th scope=\"row\">Teleoperation / Auto-recharge</th><td>Yes / Yes</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n{% endif %}\n</div>\n<script>\n  (function () {\n    var root = document.currentScript.previousElementSibling;\n    var tabs = root.querySelectorAll('[data-yc-spec-tab]');\n    tabs.forEach(function (tab) {\n      tab.addEventListener('click', function () {\n        var group = tab.closest('[data-yc-specs-group]');\n        var target = tab.getAttribute('data-yc-spec-tab');\n        group.querySelectorAll('[data-yc-spec-tab]').forEach(function (t) { t.classList.remove('is-active'); });\n        group.querySelectorAll('[data-yc-spec-panel]').forEach(function (p) { p.classList.remove('is-active'); });\n        tab.classList.add('is-active');\n        group.querySelector('[data-yc-spec-panel=\"' + target + '\"]').classList.add('is-active');\n      });\n    });\n  })();\n</script>\n\n<style>\n  .yc-story__frame { position: relative; }\n  .yc-story__frame::before, .yc-story__frame::after,\n  .yc-eng__media::before, .yc-eng__media::after {\n    content: ''; position: absolute; width: 28px; height: 28px; border: 2px solid #233923; z-index: 2; pointer-events: none;\n  }\n  .yc-eng__media::before, .yc-eng__media::after { border-color: #F2F4F1; }\n  .yc-story__frame::before, .yc-eng__media::before { top: 10px; left: 10px; border-right: none; border-bottom: none; }\n  .yc-story__frame::after, .yc-eng__media::after { bottom: 10px; right: 10px; border-left: none; border-top: none; }\n  .yc-story__frame img, .yc-eng__media img { transition: transform .6s ease-out; }\n  .yc-story__frame:hover img, .yc-eng__media:hover img { transform: scale(1.04); }\n</style>\n<script>\n  (function () {\n    function initReveal() {\n      var items = document.querySelectorAll('[data-yc-reveal]');\n      if (!items.length) return;\n      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      if (reduceMotion) {\n        items.forEach(function (el) { el.classList.add('is-visible'); });\n        return;\n      }\n      var obs = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('is-visible');\n            obs.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });\n      items.forEach(function (el) { obs.observe(el); });\n    }\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initReveal);\n    } else {\n      initReveal();\n    }\n  })();\n</script>"
      }
