    "dynamic_custom_liquid_ycEngineered": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .yc-eng { background: #10140f; padding: 72px 24px; }\n  .yc-eng__inner { max-width: 1280px; margin: 0 auto; }\n  .yc-eng__heading { color: #F2F4F1; font-size: clamp(24px, 3.4vw, 38px); font-weight: 700; line-height: 1.15; margin: 0 0 48px; text-transform: uppercase; letter-spacing: .3px; }\n  .yc-eng__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }\n  .yc-eng__media { position: sticky; top: 100px; border-radius: 16px; overflow: hidden; }\n  .yc-eng__media img { display: block; width: 100%; height: auto; }\n  .yc-eng__list { border-top: 1px solid rgba(242,244,241,.14); }\n  .yc-eng__item { position: relative; padding: 22px 0 22px 34px; border-bottom: 1px solid rgba(242,244,241,.14); cursor: pointer; }\n  .yc-eng__item::before { content: ''; position: absolute; left: 0; top: 26px; width: 14px; height: 14px; background: #233923; clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); transition: background .2s ease; }\n  .yc-eng__item.is-active::before { background: #F2F4F1; }\n  .yc-eng__item.is-active { position: relative; }\n  .yc-eng__item.is-active::after { content: ''; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: #233923; }\n  .yc-eng__title { color: rgba(242,244,241,.55); font-size: 17px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; margin: 0; transition: color .2s ease; }\n  .yc-eng__item.is-active .yc-eng__title { color: #F2F4F1; }\n  .yc-eng__text { color: rgba(242,244,241,.7); font-size: 15px; line-height: 1.6; max-height: 0; overflow: hidden; opacity: 0; transition: max-height .3s ease, opacity .3s ease, margin .3s ease; margin-top: 0; }\n  .yc-eng__item.is-active .yc-eng__text { max-height: 200px; opacity: 1; margin-top: 10px; }\n  @media screen and (max-width: 900px) { .yc-eng__grid { grid-template-columns: 1fr; gap: 28px; } .yc-eng__media { position: static; } }\n</style>\n<div class=\"yc-eng\" data-yc-reveal>\n  <div class=\"yc-eng__inner\">\n    <h2 class=\"yc-eng__heading\">Engineered for Every Season. Built to Outperform.</h2>\n    <div class=\"yc-eng__grid\">\n      <div class=\"yc-eng__media\">\n        <img src=\"{{ 'Yarbo_Core_7.jpg' | asset_url }}\" alt=\"Yarbo Core navigating a lawn with RTK GPS and vision sensors mapping the terrain\" loading=\"lazy\" width=\"1200\" height=\"1400\">\n      </div>\n      <div class=\"yc-eng__list\" data-yc-accordion>\n        <div class=\"yc-eng__item is-active\">\n          <h3 class=\"yc-eng__title\">One Core, Every Module</h3>\n          <div class=\"yc-eng__text\">One intelligent base powers every attachment: mower, snow blower, or leaf blower, swapped in minutes as the season changes. No second machine to buy or store.</div>\n        </div>\n        <div class=\"yc-eng__item\">\n          <h3 class=\"yc-eng__title\">RTK + Vision Fusion Navigation</h3>\n          <div class=\"yc-eng__text\">RTK positioning, binocular vision, and multi-sensor fusion hold a precise line to centimeter accuracy, even under tree cover where GPS-only robots drift.</div>\n        </div>\n        <div class=\"yc-eng__item\">\n          <h3 class=\"yc-eng__title\">All-Terrain Tracked Performance</h3>\n          <div class=\"yc-eng__text\">A tracked drive system and 70% (35°) climbing ability take on slopes and rough ground that stop wheeled robots outright.</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\n  (function () {\n    var acc = document.currentScript.previousElementSibling.querySelector('[data-yc-accordion]');\n    if (!acc) return;\n    acc.querySelectorAll('.yc-eng__item').forEach(function (item) {\n      item.addEventListener('click', function () {\n        acc.querySelectorAll('.yc-eng__item').forEach(function (i) { i.classList.remove('is-active'); });\n        item.classList.add('is-active');\n      });\n    });\n  })();\n</script>"
      }
    },
    "dynamic_custom_liquid_ycWhyShop": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .yc-whyshop { max-width: 1400px; margin: 0 auto; padding: 56px 24px; }\n  .yc-whyshop__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }\n  .yc-whyshop__heading { font-size: clamp(24px, 3vw, 34px); font-weight: 700; color: #232739; margin: 0; text-transform: uppercase; letter-spacing: .3px; }\n  .yc-whyshop__nav { display: flex; gap: 10px; }\n  .yc-whyshop__nav button { width: 40px; height: 40px; border-radius: 999px; border: 1px solid #DDDDDD; background: #FFFFFF; color: #232739; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: border-color .2s ease; }\n  .yc-whyshop__nav button:hover { border-color: #233923; }\n  .yc-whyshop__track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 4px; }\n  .yc-whyshop__track::-webkit-scrollbar { display: none; }\n  .yc-whyshop__card { flex: 0 0 260px; scroll-snap-align: start; background: #F2F4F1; border-radius: 12px; padding: 24px; }\n  .yc-whyshop__card-title { font-size: 16px; font-weight: 700; color: #232739; margin: 0 0 8px; text-transform: uppercase; letter-spacing: .3px; }\n  .yc-whyshop__card-text { font-size: 14px; line-height: 1.5; color: #393939; margin: 0; }\n  @media screen and (max-width: 600px) { .yc-whyshop__card { flex-basis: 220px; } }\n</style>\n<div class=\"yc-whyshop\" data-yc-reveal>\n  <div class=\"yc-whyshop__head\">\n    <h2 class=\"yc-whyshop__heading\">Why Shop With Us</h2>\n    <div class=\"yc-whyshop__nav\">\n      <button type=\"button\" aria-label=\"Scroll left\" data-yc-scroll=\"-1\">&#8592;</button>\n      <button type=\"button\" aria-label=\"Scroll right\" data-yc-scroll=\"1\">&#8594;</button>\n    </div>\n  </div>\n  <div class=\"yc-whyshop__track\" data-yc-track>\n    <div class=\"yc-whyshop__card\"><h3 class=\"yc-whyshop__card-title\">Authorized Dealer</h3><p class=\"yc-whyshop__card-text\">Every product sold through Yard Automation Pros is genuine, manufacturer-backed inventory.</p></div>\n    <div class=\"yc-whyshop__card\"><h3 class=\"yc-whyshop__card-title\">US-Based Expert Support</h3><p class=\"yc-whyshop__card-text\">Real support from people who know the product. We reply to emails within 1 business day.</p></div>\n    <div class=\"yc-whyshop__card\"><h3 class=\"yc-whyshop__card-title\">Flexible Payment Options</h3><p class=\"yc-whyshop__card-text\">Shop Pay Installments: pay in full or spread it over 3, 6, or 12 months.</p></div>\n    <div class=\"yc-whyshop__card\"><h3 class=\"yc-whyshop__card-title\">2-Year Manufacturer Warranty</h3><p class=\"yc-whyshop__card-text\">Every Yarbo unit is covered against defects from your activation date.</p></div>\n    <div class=\"yc-whyshop__card\"><h3 class=\"yc-whyshop__card-title\">Price Match Available</h3><p class=\"yc-whyshop__card-text\">Found it for less elsewhere? Ask, we'll review it on request.</p></div>\n    <div class=\"yc-whyshop__card\"><h3 class=\"yc-whyshop__card-title\">Secure Checkout</h3><p class=\"yc-whyshop__card-text\">Every order is protected with encrypted, PCI-compliant payment processing.</p></div>\n  </div>\n</div>\n<script>\n  (function () {\n    var root = document.currentScript.previousElementSibling;\n    var track = root.querySelector('[data-yc-track]');\n    if (!track) return;\n    root.querySelectorAll('[data-yc-scroll]').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var dir = parseInt(btn.getAttribute('data-yc-scroll'), 10);\n        track.scrollBy({ left: dir * 280, behavior: 'smooth' });\n      });\n    });\n  })();\n</script>"
      }
    },
