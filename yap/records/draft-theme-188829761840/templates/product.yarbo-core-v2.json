    "dynamic_custom_liquid_ycApp": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .yc-story { max-width: 1200px; margin: 0 auto; padding: 56px 24px; }\n  .yc-story__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }\n  @media screen and (max-width: 819px) { .yc-story__grid { grid-template-columns: 1fr; gap: 24px; } }\n  .yc-story__frame { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid #e5e5e5; box-shadow: 0 8px 28px rgba(35,39,57,.10); background: #0d0f14; }\n  .yc-story__frame img { display: block; width: 100%; height: auto; }\n  .yc-story__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #233923; margin: 0 0 14px; padding-bottom: 10px; border-bottom: 2px solid #233923; }\n  .yc-story__heading { font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #233923; margin: 0 0 16px; line-height: 1.2; }\n  .yc-story__text { font-size: 16px; line-height: 1.6; color: #233923; margin: 0; }\n</style>\n<div class=\"yc-story\" data-yc-reveal>\n  <div class=\"yc-story__grid\">\n    <div>\n      <span class=\"yc-story__kicker\">The Yarbo App</span>\n      <h2 class=\"yc-story__heading\">Control It From Anywhere</h2>\n      <p class=\"yc-story__text\">Check battery, see remaining area, and watch the live mowing plan for your front and back yard from your phone, wherever you are. Pause, recharge, or end a session with one tap, no need to be standing in the yard to know what the Core is doing.</p>\n    </div>\n    <div class=\"yc-story__frame\">\n      <img src=\"{{ 'Yarbo_APP_1.jpg' | asset_url }}\" alt=\"Yarbo app showing live battery, mapped zones, and mowing progress\" loading=\"lazy\" width=\"1600\" height=\"1200\">\n    </div>\n  </div>\n</div>"
