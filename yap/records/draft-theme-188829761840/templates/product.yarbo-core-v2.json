    "dynamic_custom_liquid_ycTowing": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .yc-fade { position: relative; width: 100%; min-height: 520px; margin: 20px 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }\n  .yc-fade__slide { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; animation: yc-fade-cycle 14s ease-in-out infinite; }\n  .yc-fade__slide:nth-child(1) { animation-delay: 0s; }\n  .yc-fade__slide:nth-child(2) { animation-delay: 7s; }\n  .yc-fade__overlay { position: absolute; inset: 0; background: rgba(0,0,0,.38); }\n  .yc-fade__content { position: relative; z-index: 2; text-align: center; color: #F2F4F1; max-width: 640px; padding: 0 24px; }\n  .yc-fade__heading { font-size: clamp(28px, 4vw, 42px); font-weight: 700; margin: 0 0 14px; }\n  .yc-fade__text { font-size: 17px; line-height: 1.55; margin: 0; }\n  @keyframes yc-fade-cycle { 0% { opacity: 1; } 42% { opacity: 1; } 50% { opacity: 0; } 92% { opacity: 0; } 100% { opacity: 1; } }\n  @media screen and (max-width: 749px) { .yc-fade { min-height: 380px; } }\n</style>\n<div class=\"yc-fade\" data-yc-reveal>\n  <div class=\"yc-fade__slide\" role=\"img\" aria-label=\"Yarbo Core hitched to a truck for easy transport\" style=\"background-image: url('{{ 'yarbo-truck-towing.jpg' | asset_url }}');\"></div>\n  <div class=\"yc-fade__slide\" role=\"img\" aria-label=\"Yarbo Core towing a boat trailer on its hitch\" style=\"background-image: url('{{ 'Yarbo_Core_4.jpg' | asset_url }}');\"></div>\n  <div class=\"yc-fade__overlay\"></div>\n  <div class=\"yc-fade__content\">\n    <h2 class=\"yc-fade__heading\">Beyond the Lawn</h2>\n    <p class=\"yc-fade__text\">Tow up to 500 lbs for daily tasks, or up to 3,500 lbs of rolling weight, on the same tracked base that handles your lawn. Just as easily loaded onto a hitch when it's time to move between properties or in for service.</p>\n  </div>\n</div>\n<style>\n  .yc-fade { position: relative; width: 100%; min-height: 520px; margin: 20px 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }\n  .yc-fade__slide { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 1; }\n  .yc-fade__overlay { position: absolute; inset: 0; background: rgba(0,0,0,.38); }\n  .yc-fade__content { position: relative; z-index: 2; text-align: center; color: #F2F4F1; max-width: 640px; padding: 0 24px; }\n  .yc-fade__heading { font-size: clamp(28px, 4vw, 42px); font-weight: 700; margin: 0 0 14px; }\n  .yc-fade__text { font-size: 17px; line-height: 1.55; margin: 0; }\n  @media screen and (max-width: 749px) { .yc-fade { min-height: 380px; } }\n</style>\n<div class=\"yc-fade\" data-yc-reveal>\n  <div class=\"yc-fade__slide\" role=\"img\" aria-label=\"Yarbo Core docked and charging on its snow-covered charging pad\" style=\"background-image: url('{{ 'yarbo-docking-snow.jpg' | asset_url }}');\"></div>\n  <div class=\"yc-fade__overlay\"></div>\n  <div class=\"yc-fade__content\">\n    <h2 class=\"yc-fade__heading\">Docks and Recharges Itself</h2>\n    <p class=\"yc-fade__text\">When the battery runs low or the job's done, the Core finds its own way back to the dock, recharges, and resumes automatically, through the coldest months included.</p>\n  </div>\n</div>"
      }
    },
