3,500 lbs max rolling weight</td></tr>\n          <tr><th scope=\"row\">Water resistance</th><td>IPX5</td></tr>\n          <tr><th scope=\"row\">Operating temperature</th><td>-13°F to 113°F (-25°C to 45°C)</td></tr>\n          <tr><th scope=\"row\">Connectivity</th><td>4G, Wi-Fi, Bluetooth, Wi-Fi HaLow</td></tr>\n          <tr><th scope=\"row\">Compatible modules</th><td>Lawn Mower Pro, Snow Blower, Leaf Blower</td></tr>\n          <tr><th scope=\"row\">Warranty</th><td>Yarbo's standard 2-year manufacturer warranty on defective parts, excluding consumables, from activation date</td></tr>\n          <tr><th scope=\"row\">Delivery</th><td>Approximately 10 to 14 days after payment</td></tr>\n          <tr><th scope=\"row\">What's in the box</th><td>Yarbo Core, Data Center &amp; Docking Station, Yarbo Battery</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n{% if yc_show_mower %}\n<div class=\"yc-specs\" data-yc-specs-group=\"mower\">\n  <div class=\"yc-specs__grid\">\n    <div>\n      <h2 class=\"yc-specs__heading\">Lawn Mower Pro Module Specifications</h2>\n      <div class=\"yc-specs__tabs\" data-yc-spec-tabs=\"mower\">\n        <button type=\"button\" class=\"yc-specs__tab is-active\" data-yc-spec-tab=\"mower-highlights\">Key Highlights</button>\n        <button type=\"button\" class=\"yc-specs__tab\" data-yc-spec-tab=\"mower-all\">All Specifications</button>\n      </div>\n    </div>\n    <div>\n      <table class=\"yc-specs__table is-active\" data-yc-spec-panel=\"mower-highlights\">\n        <tbody>\n          <tr><th scope=\"row\">Mowing Area per Charge (20-80%)</th><td>0.3 acre (1,214 m²)</td></tr>\n          <tr><th scope=\"row\">Mowing Area per Day</th><td>2 acres (8,090 m²)</td></tr>\n          <tr><th scope=\"row\">Max Coverage (2x/Week)</th><td>7 acres (28,300 m²)</td></tr>\n          <tr><th scope=\"row\">Cutting Width</th><td>20 in (500 mm)</td></tr>\n          <tr><th scope=\"row\">Charging Time (20-80%)</th><td>90 min</td></tr>