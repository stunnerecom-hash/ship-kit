    "dynamic_custom_liquid_ycNav": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .yc-story { max-width: 1200px; margin: 0 auto; padding: 56px 24px; }\n  .yc-story__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }\n  .yc-story--reverse .yc-story__grid { direction: rtl; }\n  .yc-story--reverse .yc-story__grid > * { direction: ltr; }\n  @media screen and (max-width: 819px) { .yc-story__grid { grid-template-columns: 1fr; gap: 24px; } .yc-story--reverse .yc-story__grid { direction: ltr; } }\n  .yc-story__frame { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid #e5e5e5; box-shadow: 0 8px 28px rgba(35,39,57,.10); }\n  .yc-story__frame img { display: block; width: 100%; height: auto; }\n  .yc-story__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #233923; margin: 0 0 14px; padding-bottom: 10px; border-bottom: 2px solid #233923; }\n  .yc-story__heading { font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #233923; margin: 0 0 16px; line-height: 1.2; }\n  .yc-story__text { font-size: 16px; line-height: 1.6; color: #233923; margin: 0; }\n</style>\n<div class=\"yc-story\" data-yc-reveal>\n  <div class=\"yc-story__grid\">\n    <div class=\"yc-story__frame\">\n      <img src=\"{{ 'Yarbo_Core_7.jpg' | asset_url }}\" alt=\"Yarbo Core following a precise edge line between pavement and lawn\" loading=\"lazy\" width=\"1600\" height=\"900\">\n    </div>\n    <div>\n      <span class=\"yc-story__kicker\">Precision Navigation</span>\n      <h2 class=\"yc-story__heading\">Holds the Line, Even at the Edge</h2>\n      <p class=\"yc-story__text\">RTK positioning, binocular vision, and multi-sensor fusion map your property to centimeter accuracy, so the Core tracks a clean edge along paths, beds, and hardscape instead of drifting the way GPS-only robots do. No boundary wires to bury or repair, and no guesswork about where the line actually is.</p>\n    </div>\n  </div>\n</div>"
      }
    },
