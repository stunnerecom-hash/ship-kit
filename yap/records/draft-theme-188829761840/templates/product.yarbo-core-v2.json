    "dynamic_custom_liquid_ycY40pCompare": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  [data-yc-reveal] { opacity: 0; transform: translateY(28px); transition: opacity .6s ease-out, transform .6s ease-out; }\n  [data-yc-reveal].is-visible { opacity: 1; transform: none; }\n  .yc-compare { max-width: 1100px; margin: 0 auto; padding: 56px 24px; }\n  .yc-compare__kicker { display: block; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #233923; margin: 0 0 10px; }\n  .yc-compare__heading { text-align: center; font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #232739; margin: 0 0 12px; line-height: 1.2; }\n  .yc-compare__sub { text-align: center; font-size: 16px; line-height: 1.6; color: #393939; max-width: 640px; margin: 0 auto 36px; }\n  .yc-compare__table { width: 100%; border-collapse: collapse; border: 1px solid #DDDDDD; border-radius: 12px; overflow: hidden; }\n  .yc-compare__table th, .yc-compare__table td { padding: 16px 20px; text-align: left; border-bottom: 1px solid #DDDDDD; font-size: 15px; }\n  .yc-compare__table tr:last-child th, .yc-compare__table tr:last-child td { border-bottom: none; }\n  .yc-compare__table thead th { background: #F2F4F1; color: #232739; font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .4px; }\n  .yc-compare__table tbody th { color: #232739; font-weight: 600; width: 34%; }\n  .yc-compare__table td { color: #393939; }\n  .yc-compare__table td.yc-compare__highlight { color: #233923; font-weight: 700; }\n  .yc-compare__note { font-size: 13px; color: #6b6b6b; margin: 16px 4px 0; }\n  .yc-compare__cta { text-align: center; margin-top: 28px; }\n  .yc-compare__cta a { display: inline-block; padding: 14px 32px; background: #233923; color: #F2F4F1; border-radius: 4px; font-weight: 700; font-size: 14px; letter-spacing: .3px; text-decoration: none; transition: background .2s ease; }\n  .yc-compare__cta a:hover { background: #152616; }\n  @media screen and (max-width: 600px) { .yc-compare__table { font-size: 13px; } .yc-compare__table th, .yc-compare__table td { padding: 12px 10px; } .yc-compare__table tbody th { width: 40%; } }\n</style>\n<div class=\"yc-compare\" data-yc-reveal>\n  <span class=\"yc-compare__kicker\">Choosing a Core</span>\n  <h2 class=\"yc-compare__heading\">Yarbo Core vs. the New Y40P Core</h2>\n  <p class=\"yc-compare__sub\">Same modular platform, same 2-year manufacturer warranty. The Y40P moves to a gearbox-free dual hub motor drivetrain, a simpler mechanism that trades gears for direct drive.</p>\n  <table class=\"yc-compare__table\">\n    <thead>\n      <tr><th scope=\"col\">Spec</th><th scope=\"col\">Yarbo Core</th><th scope=\"col\">Yarbo Core Y40P</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">Drivetrain</th><td>Dual Drive Motors</td><td class=\"yc-compare__highlight\">Dual Hub Motors, gearbox-free</td></tr>\n      <tr><th scope=\"row\">Max drive speed</th><td>0.65 m/s</td><td class=\"yc-compare__highlight\">1.2 m/s</td></tr>\n      <tr><th scope=\"row\">Climbing ability</th><td>70% (35°)</td><td>70% (35°)</td></tr>\n      <tr><th scope=\"row\">Operating noise</th><td>~60 dB</td><td>~60 dB (shared)</td></tr>\n      <tr><th scope=\"row\">Overall efficiency</th><td>Baseline</td><td class=\"yc-compare__highlight\">+15% vs. original Core platform</td></tr>\n      <tr><th scope=\"row\">Maintenance</th><td>Standard</td><td class=\"yc-compare__highlight\">Lower, fewer moving parts</td></tr>\n      <tr><th scope=\"row\">Compatible modules</th><td>Lawn Mower Pro, Snow Blower, Leaf Blower</td><td>Lawn Mower Pro, Snow Blower, Leaf Blower, Trimmer</td></tr>\n    </tbody>\n  </table>\n  <p class=\"yc-compare__note\">Modules are sold separately for both platforms. Figures are Yarbo's published specifications; consult the Specifications tab below for the full spec sheet of the Core you're viewing.</p>\n  <div class=\"yc-compare__cta\"><a href=\"/collections/yarbo\">See All Yarbo Core Options</a></div>\n</div>\n{%- liquid\n  assign yc_show_mower = false\n  assign yc_show_snow = false\n  assign yc_show_leaf = false\n  if product.handle contains 'lawn-mower-pro'\n    assign yc_show_mower = true\n  endif\n  if product.handle contains 'snow-blower'\n    assign yc_show_snow = true\n  endif\n  if product.handle contains 'leaf-blower'\n    assign yc_show_leaf = true\n  endif\n-%}\n{% if yc_show_mower or yc_show_snow or yc_show_leaf %}\n<style>\n  .yc-vs { max-width: 1100px; margin: 0 auto; padding: 48px 24px; border-top: 1px solid #DDDDDD; }\n  .yc-vs:first-of-type { border-top: none; }\n  .yc-vs__table th, .yc-vs__table td { overflow-wrap: break-word; }\n  .yc-vs__heading { text-align: center; font-size: clamp(22px, 2.8vw, 30px); font-weight: 700; color: #232739; margin: 0 0 8px; text-transform: uppercase; }\n  .yc-vs__sub { text-align: center; font-size: 15px; color: #393939; max-width: 600px; margin: 0 auto 28px; }\n  .yc-vs__table { width: 100%; border-collapse: collapse; }\n  .yc-vs__table th, .yc-vs__table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #DDDDDD; font-size: 14px; }\n  .yc-vs__table thead th { color: #232739; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .3px; background: #F2F4F1; }\n  .yc-vs__table tbody th { color: #232739; font-weight: 600; }\n  .yc-vs__table td { color: #393939; }\n  .yc-vs__table td.yc-vs__ours { color: #233923; font-weight: 700; }\n  @media screen and (max-width: 600px) { .yc-vs__table { font-size: 12.5px; } .yc-vs__table th, .yc-vs__table td { padding: 10px 8px; } }\n</style>\n{% endif %}\n{% if yc_show_mower %}\n<div class=\"yc-vs\" data-yc-reveal>\n  <h2 class=\"yc-vs__heading\">Robotic Mower vs. Traditional Methods</h2>\n  <p class=\"yc-vs__sub\">Not sure if a robotic mower is the right fit? Here's how autonomous mowing compares to the alternatives.</p>\n  <table class=\"yc-vs__table\">\n    <thead><tr><th scope=\"col\">Feature</th><th scope=\"col\">Yarbo</th><th scope=\"col\">Traditional Mower</th><th scope=\"col\">Lawn Care Service</th></tr></thead>\n    <tbody>\n      <tr><th scope=\"row\">Operation</th><td class=\"yc-vs__ours\">Fully autonomous</td><td>Manual</td><td>Manual, scheduled by provider</td></tr>\n      <tr><th scope=\"row\">Your time required</th><td class=\"yc-vs__ours\">None</td><td>Full session</td><td>None, but on provider's schedule</td></tr>\n      <tr><th scope=\"row\">Mows on your schedule</th><td class=\"yc-vs__ours\">Yes, app-scheduled, any day</td><td>Only when you operate it</td><td>Set by provider, not always convenient</td></tr>\n      <tr><th scope=\"row\">Recurring cost</th><td class=\"yc-vs__ours\">One-time investment</td><td>Fuel, oil, tune-ups each season</td><td>Per-visit or seasonal contract fees</td></tr>\n      <tr><th scope=\"row\">Scheduling</th><td class=\"yc-vs__ours\">App-controlled</td><td>Manual, weather-dependent</td><td>Set by provider</td></tr>\n      <tr><th scope=\"row\">Year-round use</th><td class=\"yc-vs__ours\">Yes (modular)</td><td>Mowing season only</td><td>Mowing season only</td></tr>\n    </tbody>\n  </table>\n</div>\n{% endif %}\n{% if yc_show_snow %}\n<div class=\"yc-vs\" data-yc-reveal>\n  <h2 class=\"yc-vs__heading\">Robotic Snow Blower vs. Traditional Methods</h2>\n  <p class=\"yc-vs__sub\">Not sure if a robotic snow blower is the right fit? Here's how autonomous blowing compares to the alternatives.</p>\n  <table class=\"yc-vs__table\">\n    <thead><tr><th scope=\"col\">Feature</th><th scope=\"col\">Yarbo</th><th scope=\"col\">Traditional Snow Blower</th><th scope=\"col\">Snow Removal Service</th></tr></thead>\n    <tbody>\n      <tr><th scope=\"row\">Operation</th><td class=\"yc-vs__ours\">Fully autonomous</td><td>Manual</td><td>Manual</td></tr>\n      <tr><th scope=\"row\">Your time required</th><td class=\"yc-vs__ours\">None</td><td>Full session</td><td>None, but on provider's schedule</td></tr>\n      <tr><th scope=\"row\">Works during/after storms</th><td class=\"yc-vs__ours\">Yes, weather-triggered, 24/7</td><td>Only when you're outside operating it</td><td>Depends on crew availability</td></tr>\n      <tr><th scope=\"row\">Recurring cost</th><td class=\"yc-vs__ours\">One-time investment</td><td>Fuel, oil, tune-ups each season</td><td>Per-visit or seasonal contract fees</td></tr>\n      <tr><th scope=\"row\">Scheduling</th><td class=\"yc-vs__ours\">App-controlled</td><td>Manual, weather-dependent</td><td>Set by provider, not always immediate</td></tr>\n      <tr><th scope=\"row\">Year-round use</th><td class=\"yc-vs__ours\">Yes (modular)</td><td>Snow season only</td><td>Snow season only</td></tr>\n    </tbody>\n  </table>\n</div>\n{% endif %}\n{% if yc_show_leaf %}\n<div class=\"yc-vs\" data-yc-reveal>\n  <h2 class=\"yc-vs__heading\">Robotic Leaf Blower vs. Traditional Methods</h2>\n  <p class=\"yc-vs__sub\">Not sure if a robotic leaf blower is the right fit? Here's how autonomous clearing compares to the alternatives.</p>\n  <table class=\"yc-vs__table\">\n    <thead><tr><th scope=\"col\">Feature</th><th scope=\"col\">Yarbo</th><th scope=\"col\">Traditional Leaf Blower</th><th scope=\"col\">Lawn/Leaf Service</th></tr></thead>\n    <tbody>\n      <tr><th scope=\"row\">Operation</th><td class=\"yc-vs__ours\">Fully autonomous</td><td>Manual</td><td>Manual, scheduled by provider</td></tr>\n      <tr><th scope=\"row\">Your time required</th><td class=\"yc-vs__ours\">None</td><td>Full session</td><td>None, but on provider's schedule</td></tr>\n      <tr><th scope=\"row\">Clears on your schedule</th><td class=\"yc-vs__ours\">Yes, app-scheduled</td><td>Only when you operate it</td><td>Set by provider, not always convenient</td></tr>\n      <tr><th scope=\"row\">Recurring cost</th><td class=\"yc-vs__ours\">One-time investment</td><td>Fuel, oil, tune-ups each season</td><td>Per-visit or seasonal contract fees</td></tr>\n      <tr><th scope=\"row\">Scheduling</th><td class=\"yc-vs__ours\">App-controlled</td><td>Manual, weather-dependent</td><td>Set by provider</td></tr>\n      <tr><th scope=\"row\">Year-round use</th><td class=\"yc-vs__ours\">Yes (modular)</td><td>Fall season only</td><td>Fall season only</td></tr>\n    </tbody>\n  </table>\n</div>\n{% endif %}\n{%- liquid\n  assign yc_show_mower = false\n  assign yc_show_snow = false\n  assign yc_show_blower = false\n  if product.handle contains 'lawn-mower-pro'\n    assign yc_show_mower = true\n  endif\n  if product.handle contains 'snow-blower'\n    assign yc_show_snow = true\n  endif\n  if product.handle contains 'leaf-blower'\n    assign yc_show_blower = true\n  endif\n-%}\n<style>\n  .yc-specs { max-width: 1200px; margin: 0 auto; padding: 56px 24px; }\n  .yc-specs + .yc-specs { padding-top: 0; }\n  .yc-specs__grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; align-items: start; }\n  .yc-specs__grid > * { min-width: 0; }\n  .yc-specs__heading, .yc-specs__tab { overflow-wrap: break-word; }\n  .yc-specs { border-top: 1px solid #DDDDDD; }\n  .yc-specs__heading { font-size: clamp(24px, 3vw, 34px); font-weight: 700; color: #232739; margin: 0 0 24px; text-transform: uppercase; letter-spacing: .3px; }\n  .yc-specs__tabs { display: flex; flex-direction: column; gap: 14px; }\n  .yc-specs__tab { background: none; border: none; text-align: left; padding: 0; font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: #6b6b6b; cursor: pointer; position: relative; padding-left: 14px; }\n  .yc-specs__tab::before { content: ''; position: absolute; left: 0; top: 5px; width: 7px; height: 7px; background: #DDDDDD; }\n  .yc-specs__tab.is-active { color: #233923; }\n  .yc-specs__tab.is-active::before { background: #233923; }\n  .yc-specs__table { width: 100%; border-collapse: collapse; display: none; }\n  .yc-specs__table.is-active { display: table; }\n  .yc-specs__table th, .yc-specs__table td { padding: 14px 4px; text-align: left; border-bottom: 1px solid #DDDDDD; font-size: 14px; }\n  .yc-specs__table th { color: #232739; font-weight: 700