    "blocks_UQPdh3": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_7d61a93_9Yy7en": {
          "type": "ai_gen_block_7d61a93",
          "settings": {
            "heading": "One Module, a Completely Different Lawn",
            "description": "This isn't an upgrade you notice once. It's the difference every single time it runs.",
            "heading_size": 36,
            "description_size": 16,
            "heading_color": "#233923",
