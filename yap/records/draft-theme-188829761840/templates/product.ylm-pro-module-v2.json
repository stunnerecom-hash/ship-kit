        "custom_liquid_visibleDesc": {
          "type": "custom-liquid",
          "name": "Visible Description",
          "settings": {
            "custom_liquid": "<style>\n  .ylm-desc { margin: 28px 0 0; }\n  .ylm-desc__heading { font-size: 22px; font-weight: 700; color: #233923; margin: 0 0 12px; line-height: 1.25; }\n  .ylm-desc__text { font-size: 15.5px; line-height: 1.6; color: #233923; margin: 0; }\n</style>\n<div class=\"ylm-desc\">\n  <h2 class=\"ylm-desc__heading\">Twice the Power, Built for the Grass That Fights Back</h2>\n  <p class=\"ylm-desc__text\">The Lawn Mower Pro Module upgrades a Yarbo Core into a heavy-duty autonomous mower built for large, demanding lawns. Dual 300W motors deliver up to 2,500W of peak power, roughly double a standard mower module, so dense Bermuda, Zoysia, St. Augustine, Buffalo Grass, and Kikuyu don't slow it down. Cutting height adjusts from 0.8 to 4.0 inches, with standard reinforced cutting discs for everyday mowing or optional SK85 high-carbon steel straight blades for a finer, lower cut. Covers up to 6 acres, riding on the Core's tracked chassis and 70% (35°) climbing ability to handle slopes and rough ground a wheeled mower can't. Requires a Yarbo Core to run, sold separately or as part of a bundle.</p>\n</div>"
          }
        },
