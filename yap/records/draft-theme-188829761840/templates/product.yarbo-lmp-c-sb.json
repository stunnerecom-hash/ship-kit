        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "What is included in this bundle?",
            "answer": "<p>The Yarbo Core, the Lawn Mower Pro Module, the Leaf Blower Module, a docking station, battery, charger, tool kit, and tow hitch. Everything you need to get started is in the box.</p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "Do I need to buy two separate machines for mowing and leaf blowing?",
            "answer": "<p>No. One Yarbo Core powers both modules. Swap between mowing and leaf blowing in under 2 minutes with no tools required.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "How does Yarbo navigate without boundary wires?",
            "answer": "<p>RTK-GPS and stereo vision map your property precisely. No trenching, no buried wires, no professional installation. You define zones in the app and Yarbo holds them.</p>",
            "icon": "none"
          }
        },
        "question_EcA6Mx": {
          "type": "question",
          "settings": {
            "question": "What size property can this bundle handle?",
            "answer": "<p>The Lawn Mower Pro Module covers up to 6 acres per charge. The Leaf Blower Module handles properties of any size. Both are built for large residential estates, not suburban quarter-acre lots.</p>",
            "icon": "none"
          }
        },
        "question_BQYmLz": {
          "type": "question",
          "settings": {
            "question": "Can it handle slopes and uneven terrain?",
            "answer": "<p>Yes. The Yarbo Core's tracked base handles slopes up to 70% grade (35 degrees). Wet ground, tree roots, and uneven terrain are not obstacles.</p>",
            "icon": "none"
          }
        },
        "question_JjXiyk": {
          "type": "question",
          "settings": {
            "question": "What happens if it encounters a pet or obstacle?",
            "answer": "<p>Yarbo's vision and ultrasonic sensors detect obstacles in real time and navigate around them automatically. It does not stop and wait — it reroutes and keeps working.</p>",
            "icon": "none"
          }
        },
        "question_JxkamV": {
          "type": "question",
          "settings": {
            "question": "What warranty comes with this bundle?",
            "answer": "<p>A 2-year warranty on defective parts covers both the Yarbo Core and all included modules. US-based support is available via AI chat anytime and by phone or email Monday to Friday.</p>",
            "icon": "none"
          }
        }
