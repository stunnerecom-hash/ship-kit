      "settings": {
        "y40p_only": true,
        "eyebrow": "Inside the Core",
        "heading": "Built simpler, built to last.",
        "intro": "Tap the numbers to see what does the work.",
        "image": "shopify://shop_images/yap-y40p-hub-motors.jpg"
      },
      "blocks": {
        "b1": {
          "type": "point",
          "settings": {
            "title": "Gearbox-free dual hub motors",
            "text": "The motors sit inside the drive hubs, so there is no gearbox to wear out. Yarbo credits this drivetrain for the Y40P's extra speed, steadier traction and lower maintenance.",
            "fact": "Up to 1.2 m/s",
            "x": 36,
            "y": 72
          }
        },
        "b2": {
          "type": "point",
          "settings": {
            "title": "Binocular vision",
            "text": "Cameras work with ultrasonic sensors and a bumper to spot obstacles, and vision, IMU and odometry keep it on course under trees where satellite signal is weak.",
            "fact": "Vision + IMU + odometry",
            "x": 32,
            "y": 46
          }
        },
        "b3": {
          "type": "point",
          "settings": {
            "title": "RTK positioning and connectivity",
            "text": "RTK satellite positioning maps your property without a boundary wire. The Core stays connected over 4G, Wi-Fi, Bluetooth and Wi-Fi HaLow.",
            "fact": "No buried wire",
            "x": 17,
            "y": 25
          }
        },
        "b4": {
          "type": "point",
          "settings": {
            "title": "Tracked drive",
            "text": "Rubber tracks keep grip on slopes up to 70% (35°), thick grass and uneven ground that stop many wheeled robots.",
            "fact": "70% (35°) climb",
            "x": 57,
            "y": 44
          }
        }
      },
