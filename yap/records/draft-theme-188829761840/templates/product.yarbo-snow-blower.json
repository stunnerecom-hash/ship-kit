        "custom_liquid_visibleDesc": {
          "type": "custom-liquid",
          "name": "Visible Description",
          "settings": {
            "custom_liquid": "<style>\n  .sb-desc { margin: 28px 0 0; }\n  .sb-desc__heading { font-size: 22px; font-weight: 700; color: #233923; margin: 0 0 12px; line-height: 1.25; }\n  .sb-desc__text { font-size: 15.5px; line-height: 1.6; color: #233923; margin: 0; }\n</style>\n<div class=\"sb-desc\">\n  <h2 class=\"sb-desc__heading\">Clears the Driveway Before You're Even Up</h2>\n  <p class=\"sb-desc__text\">The Snow Blower Module turns a Yarbo Core into a fully autonomous, two-stage snow clearing machine. It monitors weather conditions and starts clearing on its own when snowfall begins, working a 24-inch-wide path with 12 inches of intake height and throwing snow up to 40 feet, adjustable down to 6 feet for close work. The chute rotates -10° to 190° and the deflector angles from -5° to 50°, so you control exactly where the snow lands, not just that it moves. Built from Q355 steel with an IPX5 waterproof rating and rated to run from -13°F to 113°F, it auto-docks at 20% battery and resumes at 80%, continuing through a storm with no input from you. Requires a Yarbo Core, sold separately or as part of a bundle.</p>\n</div>"
          }
        },
