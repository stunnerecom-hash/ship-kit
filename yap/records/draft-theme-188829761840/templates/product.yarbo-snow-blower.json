    "dynamic_faq_8AUh7M": {
      "type": "dynamic-faq",
      "blocks": {
        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "Does the Snow Blower Module work with any Yarbo Core?",
            "answer": "<p>Yes. The Snow Blower Module attaches to any standard Yarbo Core using the quick-swap modular connector. If you're starting from scratch, the Snow Blower bundle includes the Core and module together.</p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "How wide does it clear, and how far does it throw snow?",
            "answer": "<p>24 inches wide with a 12 inch intake height. It throws snow 6 to 40 feet, adjustable. The chute rotates -10° to 190° so you control exactly where snow lands.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "Can it handle steep or gravel driveways?",
            "answer": "<p>With the Snow Blower Module attached, the Core is rated to climb up to a 36% (20°) grade. For gravel, the intake height raises up to about 2 inches so it skims the surface instead of pulling loose stone into the machine.</p>",
            "icon": "none"
          }
        },
        "question_EcA6Mx": {
          "type": "question",
          "settings": {
            "question": "How does it know when to start clearing?",
            "answer": "<p>It monitors weather conditions through the Yarbo app and starts clearing automatically when snowfall begins, then keeps working continuously through the storm to prevent buildup. You set your zones once and it handles every storm after that.</p>",
            "icon": "none"
          }
        },
        "question_BQYmLz": {
          "type": "question",
          "settings": {
            "question": "What happens when the battery runs low mid-storm?",
            "answer": "<p>It auto-docks at 20% battery and automatically resumes clearing at 80%, continuing through the storm with no input from you.</p>",
            "icon": "none"
          }
        },
        "question_JjXiyk": {
          "type": "question",
          "settings": {
            "question": "How cold can it operate in?",
            "answer": "<p>Standard operating range is -13°F to 113°F (-25°C to 45°C).</p>",
            "icon": "none"
          }
        },
        "question_JxkamV": {
          "type": "question",
          "settings": {
            "question": "What warranty and support do I get?",
            "answer": "<p>Covered by Yarbo's standard 2-year manufacturer warranty on defective parts, excluding consumables, beginning from the date your machine is activated. Supported by Yard Automation Pros before and after the sale.</p>",
            "icon": "none"
          }
        }
      },
