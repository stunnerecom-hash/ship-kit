        "custom_liquid": "<style>\n  .sb-bleed { position: relative; width: 100%; min-height: 480px; margin: 20px 0; overflow: hidden; display: flex; align-items: center; justify-content: center; background-size: cover; background-position: center; }\n  .sb-bleed__overlay { position: absolute; inset: 0; background: rgba(20,26,20,.42); }\n  .sb-bleed__content { position: relative; z-index: 2; text-align: center; color: #F2F4F1; max-width: 660px; padding: 0 24px; }\n  .sb-bleed__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #c9a84c; margin: 0 0 14px; padding-bottom: 8px; border-bottom: 2px solid #c9a84c; }\n  .sb-bleed__heading { font-size: clamp(28px, 4vw, 42px); font-weight: 700; margin: 0 0 14px; }\n  .sb-bleed__text { font-size: 17px; line-height: 1.55; margin: 0; }\n  @media screen and (max-width: 749px) { .sb-bleed { min-height: 380px; } }\n</style>\n<div class=\"sb-bleed\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Yarbo_S1_6.png?v=1787783002');\">\n  <div class=\"sb-bleed__overlay\"></div>\n  <div class=\"sb-bleed__content\">\n    <span class=\"sb-bleed__kicker\">Clears the Whole Driveway While You're Still Asleep</span>\n \n    <p class=\"sb-bleed__text\">A 24-inch-wide, two-stage path with up to 40 feet of throw distance means one pass covers real ground, not a narrow shoveled trail. It starts on its own when snowfall begins and keeps working through the storm.</p>\n  </div>\n</div>"
      }
