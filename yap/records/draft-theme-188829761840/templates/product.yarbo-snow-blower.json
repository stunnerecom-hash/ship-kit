    "dynamic_custom_liquid_snowCallout": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .sb-callout { max-width: 1100px; margin: 0 auto; padding: 56px 24px; }\n  .sb-callout__panel { display: flex; gap: 40px; align-items: center; background: #f2f4f1; border: 1px solid #d7ddd4; border-left: 4px solid #c9a84c; border-radius: 12px; padding: 36px; }\n  @media screen and (max-width: 819px) { .sb-callout__panel { flex-direction: column; text-align: center; } }\n  .sb-callout__img-wrap { flex: 0 0 220px; }\n  .sb-callout__img-wrap img { width: 100%; max-width: 220px; height: auto; border-radius: 10px; display: block; margin: 0 auto; background: #fff; }\n  .sb-callout__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #c9a84c; margin: 0 0 10px; }\n  h2.sb-callout__quote { font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; color: #233923; margin: 0 0 12px; line-height: 1.3; }\n  .sb-callout__text { font-size: 15.5px; line-height: 1.6; color: #233923; margin: 0; }\n</style>\n<div class=\"sb-callout\">\n  <div class=\"sb-callout__panel\">\n    <div class=\"sb-callout__img-wrap\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Yarbo_S1_8.png?v=1787782986\" alt=\"Close-up of the Yarbo Snow Blower Module's auger and impeller sitting in real snow\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n    </div>\n    <div>\n      <span class=\"sb-callout__kicker\">Two-Stage Auger, Up Close</span>\n      <h2 class=\"sb-callout__quote\">Built to chew through packed snow, not just push it.</h2>\n      <p class=\"sb-callout__text\">The auger pulls snow in, the impeller throws it clear, the same two-stage principle used on commercial equipment. It handles dry, wet, and packed snow without clogging the way a single-stage blower does.</p>\n    </div>\n  </div>\n</div>"
      }
    },
    "dynamic_custom_liquid_snowHeadlights": {
      "type": "dynamic-custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .sb-stack2 { max-width: 820px; margin: 0 auto; padding: 56px 24px; text-align: center; }\n  .sb-stack2__frame { border-radius: 14px; overflow: hidden; border: 1px solid #e5e5e5; box-shadow: 0 8px 28px rgba(35,39,57,.10); margin: 0 0 28px; }\n  .sb-stack2__frame img { display: block; width: 100%; height: auto; }\n  .sb-stack2__kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #c9a84c; margin: 0 0 14px; padding-bottom: 8px; border-bottom: 2px solid #c9a84c; }\n  .sb-stack2__heading { font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: #233923; margin: 0 0 16px; line-height: 1.2; }\n  .sb-stack2__text { font-size: 16px; line-height: 1.6; color: #233923; margin: 0 auto; max-width: 600px; }\n</style>\n<div class=\"sb-stack2\">\n  <div class=\"sb-stack2__frame\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0965/2056/9136/files/Yarbo_S1_7.png?v=1787783005\" alt=\"Yarbo Snow Blower Module clearing snow with front LED headlights lit in low daylight\" loading=\"lazy\" width=\"1600\" height=\"900\">\n  </div>\n  <span class=\"sb-stack2__kicker\">The Driveway Is Already Clear By the Time You Look Outside</span>\n<p class=\"sb-stack2__text\">Front LED lighting means low light or pre-dawn clearing isn't a limitation. It starts when snowfall begins, not when there's enough daylight to see by.</p>\n</div>"
      }
    },
