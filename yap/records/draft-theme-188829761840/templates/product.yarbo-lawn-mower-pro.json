        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "Does the Lawn Mower Pro module work with any Yarbo Core?",
            "answer": "<p>Yes, any standard Yarbo Core. If you’re starting fresh, the <a href=\"https://bz1drk-tc.myshopify.com/products/yarbo-lawn-mower-pro-core-lawn-mower-pro-module\">Lawn Mower Pro bundle</a> brings the Core and the module together, so your lawn is under precision care from the first day.</p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "How does the cutting height adjust to my lawn?",
            "answer": "<p>The module reads the terrain as it moves, adjusting cutting height automatically so open stretches and tight corners alike receive the same immaculate, consistent finish, no manual settings required.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "How long does it take to attach the module?",
