    },
    "dynamic_image_with_text_6CbCtL": {
      "type": "dynamic-image-with-text",
      "blocks": {
        "heading_6CbCh1": {
          "type": "heading",
          "settings": {
            "text": "Mow, Mulch, Bag, Discharge, or Vacuum Leaves",
            "heading_size": "medium"
          }
        },
        "text_6CbCt1": {
          "type": "text",
          "settings": {
            "richtext": "<p>Switch clipping modes in seconds. Mulch fine clippings back into the lawn, side-discharge for speed, or attach the bag to collect as you go. When leaves fall, the same machine becomes a 931 CFM leaf vacuum with a 70L bag one mower covers mowing season and cleanup season.</p>"
          }
        }
      },
      "block_order": [
        "heading_6CbCh1",
        "text_6CbCt1"
      ],
