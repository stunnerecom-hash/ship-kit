    "dynamic_faq_8AUh7M": {
      "type": "dynamic-faq",
      "blocks": {
        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "Is the Mowrator S1 2WD autonomous, like a robot mower?",
            "answer": "<p>No. It's a remote controlled mower, not a self navigating robot. You operate it with a handheld controller from wherever you're standing.<br/><br/></p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "What's the real difference between the 12Ah and 18Ah battery?",
            "answer": "<p>Runtime and coverage per charge. The 12Ah gives you up to 1.5 hours and covers up to 0.75 acre. The 18Ah gives you up to 2.25 hours and covers up to 1.125 acres.<br/><br/></p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "Can it handle wet or overgrown grass?",
            "answer": "<p>Yes, within reason. The front to rear airflow system and lift blade are built to handle wet, matted grass without clogging.<br/><br/></p>",
            "icon": "none"
          }
        },
        "question_EcA6Mx": {
          "type": "question",
          "settings": {
            "question": "Is it safe to use in the rain?",
            "answer": "<p>The S1 carries an IP54 rating, built to handle light rain and splashes, not heavy rain or submersion.<br/><br/></p>",
            "icon": "none"
          }
        },
        "question_BQYmLz": {
          "type": "question",
          "settings": {
            "question": "How steep a slope can the 2WD handle?",
            "answer": "<p>Up to 45% grade, or 24 degrees. If your yard has steeper sections, the 4WD version is rated for steeper slopes.<br/><br/></p>",
            "icon": "none"
          }
        },
        "question_JjXiyk": {
          "type": "question",
          "settings": {
            "question": "Who can operate it?",
            "answer": "<p>The remote is designed to be simple enough for most adults. It's still a machine with a spinning blade, keep children and pets clear.<br/><br/></p>",
            "icon": "none"
          }
        },
        "question_JxkamV": {
          "type": "question",
          "settings": {
            "question": "Does it require regular maintenance?",
            "answer": "<p>Basic upkeep applies: keep the blade clean and sharp, check for debris in the deck after use, and store the battery partially charged if unused for a while.<br/><br/></p>",
            "icon": "none"
          }
        }
      },
