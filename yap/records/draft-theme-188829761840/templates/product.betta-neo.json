    "dynamic_faq_neo": {
      "type": "dynamic-faq",
      "blocks": {
        "question_nCTWbR": {
          "type": "question",
          "settings": {
            "question": "What does the Betta Gateway actually do?",
            "answer": "<p>It's a bridge device you set up indoors that extends your connection to the Neo up to 600 ft, supporting both 5G and 2.4G Wi-Fi. It's what makes app control and remote status reliable at real-world distances.</p>",
            "icon": "none"
          }
        },
        "question_69jhiF": {
          "type": "question",
          "settings": {
            "question": "How does Weather-Adaptive cleaning work?",
            "answer": "<p>It looks at upcoming solar conditions and adjusts the cleaning schedule to match, running more during sunny stretches and conserving through cloudy ones, so it keeps working without draining the battery.</p>",
            "icon": "none"
          }
        },
        "question_8KCdGW": {
          "type": "question",
          "settings": {
            "question": "What happens on a run of cloudy days?",
            "answer": "<p>The Neo has dual charging, solar plus an adapter backup, so extended overcast weather doesn't take it offline the way a solar-only skimmer would.</p>",
            "icon": "none"
          }
        },
        "question_EcA6Mx": {
          "type": "question",
          "settings": {
            "question": "Is it safe for saltwater pools?",
            "answer": "<p>Yes. Twin Salt Chlorine Tolerant (SCT) motors are built for both saltwater and chlorine pools.</p>",
            "icon": "none"
          }
        },
        "question_BQYmLz": {
          "type": "question",
          "settings": {
            "question": "What size pool is this rated for?",
            "answer": "<p>Up to 40 ft x 60 ft, approximately 2,400 sq ft, above-ground or in-ground.</p>",
            "icon": "none"
          }
        },
        "question_JjXiyk": {
          "type": "question",
          "settings": {
            "question": "Does it avoid getting stuck on pool steps?",
            "answer": "<p>Yes. Ultrasonic radar sensing detects obstacles and includes a shallow-water safeguard specifically to keep it from wedging itself on steps or ledges.</p>",
            "icon": "none"
          }
        },
        "question_JxkamV": {
          "type": "question",
          "settings": {
            "question": "What kind of support do I get after purchase?",
            "answer": "<p>Betta's 1-year manufacturer's warranty, plus our own US based support team at support@yardautomationpros.com for setup and anything that comes up after.</p>",
            "icon": "none"
          }
        }
      },
