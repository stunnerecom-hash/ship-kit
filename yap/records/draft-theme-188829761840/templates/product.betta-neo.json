        "collapsible_tab_UWQ8gk": {
          "type": "collapsible-tab",
          "name": "Overview",
          "settings": {
            "collapsible_tab_heading": "Overview",
            "collapsible_tab_text": "<p>The Betta Neo is Betta's flagship solar-powered robotic pool skimmer, built around smart app control and an included Betta Gateway for up to 600 ft of range.<br/><br/>🌤️ Weather-Adaptive cleaning plans its schedule around upcoming solar conditions.<br/>☀️ Dual charging, solar plus adapter, keeps it running rain or shine.<br/>🛡️ Twin SCT motors and a soft-touch UV-resistant casing, safe for saltwater and chlorine pools.<br/></p>"
          }
        },
        "collapsible_tab_Uf69Wz": {
          "type": "collapsible-tab",
          "name": "Product Information",
          "settings": {
            "collapsible_tab_heading": "Product Information",
            "collapsible_tab_text": "<p><strong>Pool Skimming That Adjusts to the Weather Before You Do. By Yard Automation Pros.</strong></p><p>The Betta Neo is the top of the Betta lineup, built for pools up to roughly 2,400 sq ft (40ft x 60ft), above-ground or in-ground.</p><h3>Control it from anywhere</h3><p>The included Betta Gateway extends your connection up to 600 ft, supporting both 5G and 2.4G Wi-Fi. Manage cleaning from the Betta app no matter where you are.</p><h3>It watches the forecast, not just the clock</h3><p>Weather-Adaptive cleaning analyzes upcoming solar conditions and adjusts its schedule automatically, or follow a set schedule if you'd rather set it once and forget it.</p><h3>Built to keep running</h3><p>Dual charging, solar plus adapter backup, means cloudy stretches don't stop it. Twin Salt Chlorine Tolerant (SCT) motors handle both saltwater and chlorine pools, and a soft-touch, UV-resistant casing protects your pool liner while it works.</p><h3>Ownership, handled</h3><ul><li><strong>Ultrasonic radar</strong> with shallow-water safeguard to avoid getting stuck on steps.</li><li><strong>1-year manufacturer's warranty.</strong></li><li><strong>Curated and supported by Yard Automation Pros,</strong> before and after the sale.</li></ul>"
          }
        },
        "collapsible_tab_X7L37G": {
          "type": "collapsible-tab",
          "name": "Warranty & Support",
          "settings": {
            "collapsible_tab_heading": "Warranty & Support:",
            "collapsible_tab_text": "<p>Covered by Betta's 1-year manufacturer's warranty. We reply to emails within 1 business day at support@yardautomationpros.com.<br/><br/></p>"
          }
        },
        "collapsible_tab_HjeTwa": {
          "type": "collapsible-tab",
          "name": "Setup & Installation",
          "settings": {
            "collapsible_tab_heading": "Setup & Installation",
            "collapsible_tab_text": "<p>Set up the included Betta Gateway indoors, download the Betta app, and pair your Neo. Drop it in the pool and run it fully automatic, on a schedule, or switch to app-based manual control anytime.<br/><br/></p>"
          }
        },
        "collapsible_tab_czbJiW": {
          "type": "collapsible-tab",
          "name": "Specifications",
          "settings": {
            "collapsible_tab_heading": "Specifications",
            "collapsible_tab_text": "<h3>Cleaning &amp; Coverage</h3><ul><li><strong>Cleaning modes:</strong> Auto, Smart Weather-Adaptive, Scheduled</li><li><strong>Pool coverage:</strong> Up to 40 ft x 60 ft (approx. 2,400 sq ft)</li><li><strong>Pool compatibility:</strong> Above-ground and in-ground, saltwater and chlorine</li></ul><h3>Power &amp; Connectivity</h3><ul><li><strong>Charging:</strong> Solar-powered plus adapter backup, 24/7 operation</li><li><strong>App control:</strong> Betta app with included Betta Gateway, up to 600 ft range, 5G/2.4G Wi-Fi</li></ul><h3>Build &amp; Navigation</h3><ul><li><strong>Motors:</strong> Twin Salt Chlorine Tolerant (SCT) motors</li><li><strong>Navigation:</strong> Ultrasonic radar obstacle detection, shallow-water safeguard</li><li><strong>Casing:</strong> Soft-touch, UV-resistant</li></ul><h3>Warranty</h3><ul><li>1-year manufacturer's warranty</li></ul>"
          }
