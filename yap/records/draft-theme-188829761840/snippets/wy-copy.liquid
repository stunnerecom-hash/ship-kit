{%- comment -%}
  WYBOT copy per model, kept in the theme (WYBOT products sync from WYBOT through Shopify Collective, so page copy lives here).
  Usage: {% capture x %}{% render 'wy-copy', f: 'spec' %}{% endcapture %}   optional h: a handle (defaults to product.handle)
  Bundle handles resolve to their floor robot; f: 'bundle' returns "yes" on bundle pages, f: 'robot_handle' / 'bundle_handle' give the pair.
  Sources: wybotpool.com product pages, comparison tables, FAQs, shipping and refund policies (checked 2026-09-24).
  Marketing superlatives on WYBOT pages ("world's first", "industry-first") are deliberately not repeated.
{%- endcomment -%}
{%- liquid
  assign k = h | default: product.handle
  assign isb = false
  if k contains 'bundle'
    assign isb = true
  endif
  if k contains 'solar-vis'
    assign m = 's2sv'
  elsif k contains 's2-solar'
    assign m = 's2s'
  elsif k contains 'c2-vision' or k contains 'c2v'
    assign m = 'c2v'
  elsif k contains 'wybot-c2' or k contains 'bundle-c2'
    assign m = 'c2'
  elsif k contains 'wybot-c1' or k contains 'bundle-c1'
    assign m = 'c1'
  elsif k contains 'wybot-b1' or k contains 'bundle-b1'
    assign m = 'b1'
  elsif k contains 'wybot-a1' or k contains 'bundle-a1'
    assign m = 'a1'
  elsif k contains 'wybot-s3'
    assign m = 's3'
  elsif k contains 'wybot-f1'
    assign m = 'f1'
  else
    assign m = 's2'
  endif
