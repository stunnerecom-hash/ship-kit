<style>{% raw %}/* Call Desk. Functional, not a marketing page. System fonts only: this page makes no third-party requests. */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: #f2f4f1; }
.yd { --navy: #232739; --deep: #1a1d2b; --green: #233923; --green2: #2f4a2f; --gold: #c9a84c; --light: #f2f4f1; --tile: #eceee9; --rule: #dcdfd8; --mute: #55594f; --paper: #fff;
  --amber: #7a4b00; --amber-bg: #fff4d6; --red: #8a1c1c; --red-bg: #fde8e6; --blue: #1d3f72; --blue-bg: #e6eefb; --ok-bg: #e4f0e4;
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--navy); min-height: 100vh; display: flex; flex-direction: column; }
.yd button, .yd input, .yd select, .yd textarea { font: inherit; color: inherit; }
.yd h1, .yd h2 { margin: 0; line-height: 1.2; }
.yd p { margin: 0 0 12px; }
.yd [hidden] { display: none !important; }
.yd :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
.yd button { min-height: 48px; padding: 10px 16px; border: 1px solid var(--navy); border-radius: 8px; background: var(--paper); cursor: pointer; font-weight: 600; }
.yd button:hover { background: var(--tile); }
.yd button:disabled { opacity: .5; cursor: not-allowed; }
.yd .yd-primary { background: var(--green); border-color: var(--green); color: #fff; }
.yd .yd-primary:hover { background: var(--green2); }
.yd .yd-link { min-height: 0; padding: 0; border: 0; background: none; text-decoration: underline; font-weight: 600; }
.yd-mute { color: var(--mute); font-size: 14px; }
.yd-lab { display: block; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); margin: 0 0 6px; }

/* header */
.yd-top { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 10px 16px; background: var(--navy); color: #fff; }
.yd-timer { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 18px; }
.yd-timer::before { content: ""; display: inline-block; width: 10px; height: 10px; margin-right: 8px; border-radius: 50%; background: var(--gold); }
.yd-caller { font-weight: 600; flex: 1 1 200px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.yd-status { font-size: 13px; color: #d9dccf; }
.yd .yd-chip { min-height: 36px; padding: 4px 12px; border: 1px solid var(--gold); border-radius: 999px; background: var(--amber-bg); color: var(--amber); font-size: 13px; }
.yd .yd-rep { min-height: 36px; padding: 4px 12px; border-color: #8f93a6; background: transparent; color: #fff; font-size: 13px; }
.yd .yd-rep:hover { background: var(--deep); }
.yd .yd-rep--missing { border-color: var(--gold); color: var(--gold); }

/* rail */
.yd-rail { display: flex; gap: 6px; padding: 8px 16px; background: var(--paper); border-bottom: 1px solid var(--rule); overflow-x: auto; }
.yd .yd-rail button { min-height: 40px; padding: 6px 12px; border-color: var(--rule); font-size: 14px; white-space: nowrap; flex: 0 0 auto; }
.yd .yd-rail button.is-on { background: var(--navy); border-color: var(--navy); color: #fff; }

/* main */
.yd-main { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 16px; padding: 16px; max-width: 1280px; width: 100%; margin: 0 auto; align-items: start; }
.yd-card, .yd-side { background: var(--paper); border: 1px solid var(--rule); border-radius: 12px; padding: 20px; }
.yd-side { position: sticky; top: 64px; }
.yd-side h2 { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); margin: 0 0 8px; }
.yd-side__head { display: flex; justify-content: space-between; align-items: center; }
.yd-side .yd-x { display: none; }
.yd-sum { margin: 0 0 16px; padding-left: 18px; }
.yd-sum li { margin-bottom: 4px; }
.yd-notes { width: 100%; }
.yd-head { margin-bottom: 14px; }
.yd-head h1 { font-size: 24px; margin-top: 4px; }
.yd-stage { font-size: 13px; color: var(--mute); font-weight: 600; margin-right: 8px; }
.yd-say { background: var(--light); border-left: 5px solid var(--green); border-radius: 8px; padding: 14px 16px; margin: 0 0 16px; }
.yd-say p { font-size: 19px; line-height: 1.45; margin: 0; }
.yd-ask { margin: 0 0 16px; }
.yd-askline { font-weight: 600; }
.yd-why { background: var(--paper); border: 1px dashed var(--rule); border-radius: 8px; padding: 10px 14px; color: var(--mute); font-size: 15px; }
.yd-why .yd-lab { display: inline; margin-right: 6px; }
.yd-nav { display: grid; grid-template-columns: auto 1fr auto auto; gap: 10px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--rule); }
.yd-nav .yd-primary { min-width: 120px; }

/* options */
.yd-opts { display: grid; gap: 8px; margin: 0 0 12px; }
.yd-opts--jobs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.yd-opts--row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.yd .yd-opt { display: flex; align-items: center; gap: 10px; text-align: left; width: 100%; border-color: var(--rule); border-width: 2px; font-weight: 500; }
.yd .yd-opt.is-on { border-color: var(--green); background: var(--ok-bg); font-weight: 700; }
.yd .yd-opt.is-on .yd-opt__l::after { content: " (selected)"; font-weight: 500; font-size: 13px; color: var(--mute); }
.yd-opt__l { flex: 1; }
.yd-key { flex: 0 0 auto; width: 24px; height: 24px; border-radius: 6px; background: var(--tile); font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
.yd-tag { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; border: 1px solid; white-space: nowrap; vertical-align: middle; }
.yd-tag--ok { color: var(--green); background: var(--ok-bg); border-color: var(--green); }
.yd-tag--caution { color: var(--amber); background: var(--amber-bg); border-color: var(--amber); }
.yd-tag--confirm { color: var(--blue); background: var(--blue-bg); border-color: var(--blue); }
.yd-tag--nofit { color: var(--red); background: var(--red-bg); border-color: var(--red); }
.yd-tag--must { color: #fff; background: var(--navy); border-color: var(--navy); }
.yd-must { background: var(--amber-bg); border: 1px solid var(--amber); border-radius: 8px; padding: 10px 14px; color: #3d2600; font-size: 17px; }
.yd-must-inline { color: #3d2600; }
.yd-warn { background: var(--red-bg); border: 1px solid var(--red); border-radius: 8px; padding: 10px 14px; color: #4d0f0f; }

/* fields */
.yd-field { margin: 0 0 12px; }
.yd-field label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 4px; }
.yd-field input, .yd-field select, .yd-field textarea, .yd-notes { width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid #8a8e84; border-radius: 8px; background: #fff; }
.yd-field--inline { max-width: 360px; }
.yd-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; }
.yd-dims { display: grid; grid-template-columns: 1fr auto 1fr 1.2fr; gap: 8px; align-items: end; }
.yd-times { padding-bottom: 24px; font-weight: 700; }
.yd-checks { display: grid; gap: 4px; margin: 0 0 12px; }
.yd-check { display: flex; gap: 10px; align-items: flex-start; min-height: 44px; padding: 8px 4px; cursor: pointer; }
.yd-check input { width: 22px; height: 22px; margin: 2px 0 0; flex: 0 0 auto; accent-color: var(--green); }

/* recommendation */
.yd-cat { border-top: 2px solid var(--navy); padding-top: 14px; margin-top: 18px; }
.yd-cat:first-child { border-top: 0; margin-top: 0; padding-top: 0; }
.yd-cat h2 { font-size: 20px; margin-bottom: 12px; }
.yd-prod { border: 2px solid var(--rule); border-radius: 10px; padding: 14px; margin: 0 0 12px; }
.yd-prod.is-on { border-color: var(--green); }
.yd-prod--missing { border-style: dashed; }
.yd-prod__top { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: baseline; margin-bottom: 8px; }
.yd-role { grid-column: 1 / -1; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); }
.yd-prod__t { font-size: 17px; }
.yd-price { font-size: 20px; font-weight: 800; font-variant-numeric: tabular-nums; }
.yd-picked { margin: 0; font-weight: 700; color: var(--green); }
.yd-list { margin: 0 0 12px; padding-left: 20px; }
.yd-list li { margin-bottom: 4px; }
.yd-list--limit li::marker { content: "! "; font-weight: 800; color: var(--red); }
.yd-add { border: 1px solid var(--rule); border-radius: 8px; padding: 10px; margin-bottom: 8px; }
.yd-route, .yd-caut, .yd-conf, .yd-nofit, .yd-disc, .yd-link-box { border: 1px solid var(--rule); border-radius: 10px; padding: 12px 14px; margin: 0 0 12px; }
.yd-nofit { border-color: var(--red); background: #fff8f7; }
.yd-conf { border-color: var(--blue); background: #f7faff; }
.yd-override { margin-top: 12px; }
.yd-total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px; background: var(--navy); color: #fff; border-radius: 10px; margin: 16px 0 12px; }
.yd-total b { font-size: 20px; }
.yd-fact { border-left: 4px solid var(--green); padding: 6px 12px; margin: 0 0 10px; background: var(--light); border-radius: 0 8px 8px 0; }
.yd-fact p { margin: 2px 0 0; }
.yd-fact--pending { border-left-color: var(--blue); background: var(--blue-bg); }
.yd-fact .yd-tag { margin-left: 8px; }
.yd-quote { width: 100%; border-collapse: collapse; margin: 0 0 8px; }
.yd-quote caption { text-align: left; }
.yd-quote td { padding: 8px 4px; border-bottom: 1px solid var(--rule); }
.yd-quote td:last-child { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 700; }
.yd-quote__t td { font-weight: 800; border-bottom: 0; font-size: 18px; }
.yd-pm { border: 1px solid var(--rule); border-radius: 10px; padding: 0 14px; margin: 12px 0 0; }
.yd-pm summary { min-height: 48px; display: flex; align-items: center; cursor: pointer; font-weight: 700; }
.yd-pm[open] { padding-bottom: 12px; }
.yd-copied { margin-left: 10px; font-weight: 700; color: var(--green); }
.yd-dispo { border: 0; padding: 0; margin: 0 0 12px; display: grid; gap: 8px; }
.yd-dispo legend { font-weight: 700; margin-bottom: 8px; }
.yd-wrap-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0; }
.yd-done { border: 1px solid var(--rule); border-radius: 8px; padding: 10px; margin-bottom: 8px; }
.yd-done--old { border-color: var(--amber); background: var(--amber-bg); }
.yd-hold { font-size: 44px; font-weight: 800; font-variant-numeric: tabular-nums; margin: 8px 0; }

.yd-pains { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
.yd .yd-pain { min-height: 44px; padding: 8px 14px; border: 2px solid var(--rule); border-radius: 999px; font-weight: 500; }
.yd .yd-pain.is-on { border-color: var(--green); background: var(--ok-bg); font-weight: 700; }
.yd .yd-pain.is-on::before { content: "✓ "; }
.yd-lead { border-top: 1px solid var(--rule); padding-top: 12px; margin-top: 4px; }
.yd-boxes { border: 1px solid var(--rule); border-radius: 10px; padding: 12px 14px; margin: 0 0 12px; background: var(--paper); }
.yd-quiet { margin-top: 8px !important; font-size: 15px !important; font-weight: 700; color: var(--red); }
.yd .yd-chip--cb { border-color: #ffb4a8; background: var(--red-bg); color: var(--red); }
.yd-owed { text-align: left; }
.yd a.yd-btn { display: inline-flex; align-items: center; min-height: 48px; padding: 10px 16px; border: 1px solid var(--navy); border-radius: 8px; color: var(--navy); font-weight: 600; text-decoration: none; margin: 0 0 12px; }
.yd a.yd-btn:hover { background: var(--tile); }

.yd-sec { border-top: 1px solid var(--rule); padding-top: 14px; margin-top: 16px; }
.yd-sec h2 { font-size: 18px; margin-bottom: 10px; }
.yd-sheet-top { margin-bottom: 14px; }
.yd-benefits li { font-size: 17px; margin-bottom: 8px; }
.yd-benefits li.is-hit { font-weight: 600; }
.yd-faq { border: 1px solid var(--rule); border-radius: 8px; padding: 0 14px; margin: 0 0 8px; }
.yd-faq summary { min-height: 48px; display: flex; align-items: center; cursor: pointer; font-weight: 600; }
.yd-faq p { font-size: 17px; }
.yd-qc label { font-weight: 500; font-size: 15px; }
.yd-pgroup { margin-bottom: 6px; }
.yd-warm { margin: 10px 0 0; font-size: 14px; color: var(--green); }
.yd-warm .yd-lab { display: inline; color: var(--green); margin-right: 6px; }
.yd .yd-opt b { white-space: nowrap; }

/* bottom bar */
.yd-bar { position: sticky; bottom: 0; z-index: 5; display: flex; gap: 8px; padding: 8px 16px; background: var(--paper); border-top: 1px solid var(--rule); overflow-x: auto; }
.yd .yd-bar button { flex: 0 0 auto; }
.yd .yd-end { margin-left: auto; border-color: var(--red); color: var(--red); }
.yd .yd-only-m { display: none; }

/* drawer */
.yd-drawer { position: fixed; inset: 0; z-index: 20; background: rgba(26, 29, 43, .55); display: flex; justify-content: flex-end; }
.yd-drawer__box { width: min(560px, 100%); height: 100%; overflow-y: auto; background: var(--paper); padding: 20px; }
.yd-drawer__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; position: sticky; top: -20px; background: var(--paper); padding: 12px 0; z-index: 1; }
.yd-drawer__head h2 { font-size: 20px; }

/* idle */
.yd-idle { max-width: 520px; margin: 12vh auto 0; padding: 24px 16px; display: grid; gap: 14px; text-align: center; }
.yd-idle h1 { font-size: 28px; }
.yd .yd-big { min-height: 72px; font-size: 22px; }
.yd-ok { color: var(--green); font-weight: 700; }
.yd-ask-resume { font-size: 19px; }

@media (max-width: 899px) {
  .yd-main { grid-template-columns: minmax(0, 1fr); padding: 12px 16px; }
  .yd-card { padding: 16px; }
  .yd-side { display: none; position: fixed; inset: auto 0 0 0; top: auto; z-index: 15; max-height: 75vh; overflow-y: auto; border-radius: 16px 16px 0 0; box-shadow: 0 -8px 30px rgba(26, 29, 43, .3); }
  .yd-side.is-open { display: block; }
  .yd-side .yd-x { display: inline-block; }
  .yd .yd-only-m { display: inline-block; }
  .yd-head h1 { font-size: 21px; }
  .yd-say p { font-size: 18px; }
  .yd-opts--jobs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .yd-opts--row { grid-template-columns: minmax(0, 1fr); }
  .yd-grid2 { grid-template-columns: minmax(0, 1fr); }
  .yd-dims { grid-template-columns: 1fr auto 1fr; }
  .yd-dims .yd-field:last-child { grid-column: 1 / -1; }
  .yd-nav { grid-template-columns: 1fr 1fr 1.4fr; }
  .yd-nav span { display: none; }
  .yd-status { flex-basis: 100%; order: 5; }
}
@media (prefers-reduced-motion: no-preference) { .yd-opt, .yd button { transition: background-color .12s ease, border-color .12s ease; } }
